  <!--
    After publishing, move all managed DLLs into a libs\ subfolder.
    must remain beside the exe and are excluded from the move.
  -->
  <Target Name="MoveDllsToLibsFolder" AfterTargets="Publish">
    <PropertyGroup>
      <_LibsDir>$(PublishDir)libs\</_LibsDir>
    </PropertyGroup>

    <!-- Native DLLs that MUST stay beside the exe -->
    <ItemGroup>
      <_NativeKeep Include="&#xD;&#xA;        $(PublishDir)xcompress64.dll;&#xD;&#xA;        $(PublishDir)xg.dll;&#xD;&#xA;        $(PublishDir)granny2_x64.dll;&#xD;&#xA;        $(PublishDir)e_sqlite3.dll;&#xD;&#xA;        $(PublishDir)createdump.exe;&#xD;&#xA;        $(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll;&#xD;&#xA;        $(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.Net.dll;&#xD;&#xA;        $(PublishDir)WebView2Loader.dll;&#xD;&#xA;        $(PublishDir)WinRTSupport.dll" />

      <_AppKeep Include="&#xD;&#xA;        $(PublishDir)ForzaTech Studio.exe;&#xD;&#xA;        $(PublishDir)ForzaTech Studio.dll;&#xD;&#xA;        $(PublishDir)ForzaTech Studio.runtimeconfig.json;&#xD;&#xA;        $(PublishDir)ForzaTech Studio.deps.json;&#xD;&#xA;        $(PublishDir)WinRT.Runtime.dll;&#xD;&#xA;        $(PublishDir)Microsoft.WinUI.dll;&#xD;&#xA;        $(PublishDir)Microsoft.Windows.SDK.NET.dll;&#xD;&#xA;        $(PublishDir)Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
      <!-- WebView2 native loader must stay beside the exe (loaded via LoadLibrary) -->
      <_WebViewKeep Include="$(PublishDir)Microsoft.Web.WebView2.*.dll" />
      <_WebViewKeep Include="$(PublishDir)WebView2Loader.dll" />

      <_XamlComponentKeep Include="$(PublishDir)CommunityToolkit.WinUI*.dll" />
      <_XamlComponentKeep Include="$(PublishDir)ColorCode.WinUI.dll" />
      <_XamlComponentKeep Include="$(PublishDir)ColorCode.Core.dll" />
      <_XamlComponentKeep Include="$(PublishDir)HelixToolkit.WinUI.dll" />
      <_XamlComponentKeep Include="$(PublishDir)HelixToolkit.SharpDX.Core.dll" />
      <_XamlComponentKeep Include="$(PublishDir)HelixToolkit.dll" />
    </ItemGroup>

    <!-- Collect all DLLs in the publish root that are NOT in the keep lists -->
    <ItemGroup>
      <_AllPublishDlls Include="$(PublishDir)*.dll" />
      <_DllsToMove Include="@(_AllPublishDlls)" Exclude="@(_NativeKeep);@(_AppKeep);@(_WebViewKeep);@(_XamlComponentKeep)" />
    </ItemGroup>

    <MakeDir Directories="$(_LibsDir)" Condition="'@(_DllsToMove)' != ''" />

    <Move SourceFiles="@(_DllsToMove)" DestinationFolder="$(_LibsDir)" Condition="'@(_DllsToMove)' != ''" />

    <Message Text="Moved @(_DllsToMove-&gt;Count()) DLLs to $(_LibsDir)" Importance="high" />
  </Target>
  <ItemGroup>
    <PRIResource Remove="Resources\**" />
  </ItemGroup>

