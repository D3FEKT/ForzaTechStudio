<UserControl
    x:Class="ForzaTechStudio.Views.Controls.MaterialParameterEditorView"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:ForzaTechStudio.Helpers"
    xmlns:vm="using:ForzaTechStudio.ViewModels"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    xmlns:converters="using:ForzaTechStudio.Converters"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NameHashConverter x:Key="NameHashConverter"/>
        <converters:IntToDoubleConverter x:Key="IntToDoubleConverter"/>
        
        <DataTemplate x:Key="TextureTemplate" x:DataType="vm:ShaderParameterViewModel">
             <Grid ColumnSpacing="4">
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="Auto"/>
                 </Grid.ColumnDefinitions>
                 <TextBox Text="{x:Bind TexturePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Texture Path"
                          FontSize="11"
                          MinHeight="28"
                          Padding="6,2"/>
                 <Button Grid.Column="1" Content="..." 
                         Command="{x:Bind BrowseTextureCommand}"
                         MinWidth="28"
                         MinHeight="28"
                         Padding="4,2"
                         ToolTipService.ToolTip="Browse File"/>
             </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoolTemplate" x:DataType="vm:ShaderParameterViewModel">
            <ToggleSwitch IsOn="{x:Bind BoolValue, Mode=TwoWay}" OnContent="True" OffContent="False" FontSize="11" MinHeight="28"/>
        </DataTemplate>

        <DataTemplate x:Key="FloatTemplate" x:DataType="vm:ShaderParameterViewModel">
            <NumberBox Value="{x:Bind FloatValue, Mode=TwoWay}" SpinButtonPlacementMode="Inline" SmallChange="0.1" LargeChange="1.0" FontSize="11" MinHeight="28"/>
        </DataTemplate>

        <DataTemplate x:Key="IntTemplate" x:DataType="vm:ShaderParameterViewModel">
            <NumberBox Value="{x:Bind IntValue, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10" FontSize="11" MinHeight="28"/>
        </DataTemplate>

        <DataTemplate x:Key="VectorTemplate" x:DataType="vm:ShaderParameterViewModel">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <NumberBox Header="X" Value="{x:Bind VectorX, Mode=TwoWay}" Width="62" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                <NumberBox Header="Y" Value="{x:Bind VectorY, Mode=TwoWay}" Width="62" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                <NumberBox Header="Z" Value="{x:Bind VectorZ, Mode=TwoWay}" Width="62" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                <NumberBox Header="W" Value="{x:Bind VectorW, Mode=TwoWay}" Width="62" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorTemplate" x:DataType="vm:ShaderParameterViewModel">
            <Grid ColumnSpacing="4">
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="*"/>
                 </Grid.ColumnDefinitions>
                 <Button Width="42" Height="28" Padding="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                     <Button.Flyout>
                         <Flyout>
                             <ColorPicker Color="{Binding CurrentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          IsColorSpectrumVisible="True" 
                                          IsColorChannelTextInputVisible="True"/> 
                         </Flyout>
                     </Button.Flyout>
                     <Rectangle Width="50" Height="30">
                         <Rectangle.Fill>
                             <SolidColorBrush Color="{x:Bind CurrentColor, Mode=OneWay}"/>
                         </Rectangle.Fill>
                     </Rectangle>
                 </Button>
                 <NumberBox Grid.Column="1" Value="{x:Bind VectorX, Mode=TwoWay}" ToolTipService.ToolTip="Red (Linear)" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                 <NumberBox Grid.Column="2" Value="{x:Bind VectorY, Mode=TwoWay}" ToolTipService.ToolTip="Green (Linear)" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                 <NumberBox Grid.Column="3" Value="{x:Bind VectorZ, Mode=TwoWay}" ToolTipService.ToolTip="Blue (Linear)" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
                 <NumberBox Grid.Column="4" Value="{x:Bind VectorW, Mode=TwoWay}" ToolTipService.ToolTip="Alpha" SpinButtonPlacementMode="Compact" FontSize="10" MinHeight="28"/>
            </Grid>
        </DataTemplate>
        
        <DataTemplate x:Key="SamplerTemplate" x:DataType="vm:ShaderParameterViewModel">
             <StackPanel Spacing="4" Orientation="Horizontal">
                 <ComboBox Header="Address U" SelectedIndex="{x:Bind AddressU, Mode=TwoWay}" MinWidth="84" FontSize="11" MinHeight="28">
                     <x:String>Wrap</x:String> 
                     <x:String>Mirror</x:String> 
                     <x:String>Clamp</x:String>
                     <x:String>Border</x:String>
                 </ComboBox>
                 <ComboBox Header="Address V" SelectedIndex="{x:Bind AddressV, Mode=TwoWay}" MinWidth="84" FontSize="11" MinHeight="28">
                     <x:String>Wrap</x:String> 
                     <x:String>Mirror</x:String> 
                     <x:String>Clamp</x:String>
                     <x:String>Border</x:String>
                 </ComboBox>
             </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DefaultTemplate" x:DataType="vm:ShaderParameterViewModel">
             <TextBlock Text="Unsupported Type" FontStyle="Italic" Opacity="0.5"/>
        </DataTemplate>

        <helpers:ShaderParameterTemplateSelector x:Key="ParamSelector"
            TextureTemplate="{StaticResource TextureTemplate}"
            BoolTemplate="{StaticResource BoolTemplate}"
            FloatTemplate="{StaticResource FloatTemplate}"
            IntTemplate="{StaticResource IntTemplate}"
            VectorTemplate="{StaticResource VectorTemplate}"
            ColorTemplate="{StaticResource ColorTemplate}"
            SamplerTemplate="{StaticResource SamplerTemplate}"
            DefaultTemplate="{StaticResource DefaultTemplate}"/>

        <CollectionViewSource x:Key="GroupedParams" IsSourceGrouped="True" Source="{x:Bind GroupedParameters, Mode=OneWay}"/>
    </UserControl.Resources>

    <ListView ItemsSource="{Binding Source={StaticResource GroupedParams}}" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ShaderParameterViewModel">
               <Grid Margin="0,4,0,10" Padding="0,0,8,0" RowSpacing="4">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                   </Grid.RowDefinitions>
                   
                   <Grid ColumnSpacing="8">
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                       </Grid.ColumnDefinitions>

                       <StackPanel VerticalAlignment="Top">
                           <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
                           <TextBlock Text="{x:Bind NameHash, Converter={StaticResource NameHashConverter}}" 
                                      FontSize="9" Opacity="0.5" Margin="0,1,0,0"/>
                       </StackPanel>

                        <Button Grid.Column="1" 
                                VerticalAlignment="Top"
                                MinWidth="28"
                                MinHeight="26"
                                Padding="6,3"
                                Click="RemoveParameter_Click"
                                Tag="{x:Bind Parameter}"
                                ToolTipService.ToolTip="Remove Parameter">
                            <SymbolIcon Symbol="Delete"/>
                        </Button>
                   </Grid>

                   <ContentControl Grid.Row="1" 
                                   Content="{x:Bind}" 
                                   ContentTemplateSelector="{StaticResource ParamSelector}" 
                                   HorizontalContentAlignment="Stretch"/>
               </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
        
        <ListView.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate x:DataType="controls:ParameterGroup">
                        <TextBlock Text="{x:Bind Key}" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,8"/>
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ListView.GroupStyle>
    </ListView>
</UserControl>
