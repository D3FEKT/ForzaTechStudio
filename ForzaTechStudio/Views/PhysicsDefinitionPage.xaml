<Page
    x:Class="ForzaTechStudio.Views.PhysicsDefinitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    xmlns:converters="using:ForzaTechStudio.Converters"
    x:Name="Root"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <converters:NotNullToVisibilityConverter x:Key="NullToVisibilityConverter" Inverse="True"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Inverse="True"/>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <controls:StandardPageHeader Grid.Row="0" 
                                     Title="Physics Definition" 
                                     Description="Create and view basic info on physicsdefinition.bin files"
                                     Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.NewCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenExistingCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open Existing"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SaveCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Command="{x:Bind ViewModel.CloseCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               VerticalAlignment="Center" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Empty state -->
        <Grid Grid.Row="1"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE945;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop a physicsdefinition.bin here, or use New / Open Existing"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration Side -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,16,0">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="Generation Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Model Version" FontWeight="SemiBold"/>
                            <NumberBox Value="{x:Bind ViewModel.TargetVersion, Mode=TwoWay}" 
                                       Minimum="1" 
                                       SpinButtonPlacementMode="Inline"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Source Modelbins" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{x:Bind ViewModel.SourceModels}" 
                                      Height="200" 
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                      BorderThickness="1"
                                      CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind}"/>
                                            <Button Grid.Column="1" 
                                                    Style="{StaticResource GhostAccentButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    Click="RemoveModelButton_Click">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Command="{x:Bind ViewModel.PickModelBinsCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="Add Modelbins"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Definition Type" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AllTypes}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Generation Mode" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AllGenerationModes}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedGenerationMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedGenerationMode, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PointCloud}">
                            <TextBlock Text="Point Cloud Count" FontWeight="SemiBold"/>
                            <NumberBox Value="{x:Bind ViewModel.PointCount, Mode=TwoWay}" 
                                       Minimum="1" Maximum="10000" 
                                       SpinButtonPlacementMode="Inline"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedGenerationMode, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ConvexHull}">
                            <TextBlock Text="Convex Hull Vertices" FontWeight="SemiBold"/>
                            <NumberBox Value="{x:Bind ViewModel.PointCount, Mode=TwoWay}" 
                                       Minimum="1" Maximum="1000" 
                                       SpinButtonPlacementMode="Inline"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Button Command="{x:Bind ViewModel.GenerateCommand}" 
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Padding="12">
                            <TextBlock Text="Generate Physics" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview Side -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Binary Preview" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.CurrentList, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <ListView ItemsSource="{x:Bind ViewModel.CurrentList.Definitions, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Physics Definition" FontWeight="Bold" FontSize="16"/>
                                                
                                                <Grid ColumnSpacing="16" RowSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Version:" Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}"/>

                                                    <TextBlock Grid.Row="1" Text="Type:" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DefinitionType}"/>

                                                    <TextBlock Grid.Row="2" Text="Mass:" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Mass}"/>

                                                    <TextBlock Grid.Row="3" Text="AABB Center:" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AabbCentreOffset}"/>

                                                    <TextBlock Grid.Row="4" Text="Half Extents:" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HalfExtents}"/>

                                                    <TextBlock Grid.Row="5" Text="Radius:" Opacity="0.7"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BoundingRadius}"/>
                                                </Grid>

                                                <TextBlock Text="Collision Shapes" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Shapes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,4">
                                                                <FontIcon Glyph="&#xE945;" FontSize="12" Opacity="0.7"/>
                                                                <TextBlock Text="{Binding Type}"/>
                                                                <TextBlock Text=" - "/>
                                                                
                                                                <!-- Point Cloud -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding PointCloud, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding PointCloud.Points.Count}"/>
                                                                    <TextBlock Text=" points"/>
                                                                </StackPanel>

                                                                <!-- Sphere -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Sphere, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                                    <TextBlock Text="Radius: "/>
                                                                    <TextBlock Text="{Binding Sphere.Radius}"/>
                                                                </StackPanel>

                                                                <!-- Box -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding Box, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                                    <TextBlock Text="Extents: "/>
                                                                    <TextBlock Text="{Binding Box.HalfExtents}"/>
                                                                </StackPanel>

                                                                <!-- Convex Hull -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ConvexHull, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding ConvexHull.Vertices.Count}"/>
                                                                    <TextBlock Text=" vertices"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding Children.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                                    <TextBlock Text="Children:" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Children.Count}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                                Visibility="{x:Bind ViewModel.CurrentList, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE91B;" FontSize="64" Opacity="0.2"/>
                        <TextBlock Text="No physics definition loaded" Opacity="0.5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
