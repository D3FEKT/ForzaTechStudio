<Page
    x:Class="ForzaTechStudio.Views.ModelBinCreatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    mc:Ignorable="d">


    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:NullToVisibilityConverter x:Key="NullToVis"/>
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="StepperButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource StepperButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Padding="32" MaxWidth="1680" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Modelbin Creator" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Convert 3D models into Forza .modelbin format" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Info Bar -->
            <InfoBar Grid.Row="1" Title="Status" IsOpen="True" IsClosable="False" Severity="Informational" 
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Margin="0,0,0,24"/>

            <!-- Custom Stepper -->
            <ScrollViewer Grid.Row="2"
                          Margin="0,0,0,24"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <Grid MinWidth="980" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Step1Btn" Style="{StaticResource StepperButtonActiveStyle}" Content="1. Import &amp; Sources" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="Import"/>
                    <Rectangle Grid.Column="1" Height="2" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0"/>
                    <Button x:Name="Step2Btn" Grid.Column="2" Style="{StaticResource StepperButtonStyle}" Content="2. Material Assignment" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="Materials" IsEnabled="{x:Bind ViewModel.IsZipLoaded, Mode=OneWay}"/>
                    <Rectangle Grid.Column="3" Height="2" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0"/>
                    <Button x:Name="Step3Btn" Grid.Column="4" Style="{StaticResource StepperButtonStyle}" Content="3. Configuration &amp; Export" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="Config" IsEnabled="{x:Bind ViewModel.IsZipLoaded, Mode=OneWay}"/>
                </Grid>
            </ScrollViewer>

            <!-- Content Area -->
            <Grid Grid.Row="3">
                <!-- Import Content -->
                <ScrollViewer x:Name="ImportContent" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,24">
                    <StackPanel Spacing="24" MaxWidth="1120" HorizontalAlignment="Center">
                        <!-- Target Game -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Target Game" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Select the destination Forza game. This determines the vertex layout and data encoding." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.GameTargetOptions}" SelectedItem="{x:Bind ViewModel.SelectedGameTarget, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="16" Margin="0,8,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.VlayLayoutDescription, Mode=OneWay}" FontFamily="Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.TargetFormatSummary, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Source Model -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Source Model" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Choose the 3D model (.obj or .fbx) to convert." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                    <TextBox Text="{x:Bind ViewModel.InputFilePath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No file selected" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.PickInputFileCommand}" Content="Browse File" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.IsFileSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ComboBox Header="Forward Axis" ItemsSource="{x:Bind ViewModel.AxisOptions}" SelectedItem="{x:Bind ViewModel.SelectedForwardAxis, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                    <ComboBox Grid.Column="1" Header="Up Axis" ItemsSource="{x:Bind ViewModel.AxisOptions}" SelectedItem="{x:Bind ViewModel.SelectedUpAxis, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.MtlStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsFileSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Material Library -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Material Library" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Select the shared material .zip file. Automatically loaded from the configured game path when a Target Game is selected." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                    <TextBox Text="{x:Bind ViewModel.MaterialZipPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No material library selected" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.PickMaterialZipCommand}" Content="Browse Zip" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ReloadFromConfiguredGameCommand}" Content="Reload from game" VerticalAlignment="Center"/>
                                </Grid>
                                <ComboBox ItemsSource="{x:Bind ViewModel.MaterialZipOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMaterialZipOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Header="Multiple zips found — select one to use:"
                                          Visibility="{x:Bind ViewModel.HasMaterialZipDropdown, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{x:Bind ViewModel.MaterialZipSourceLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsZipLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar IsIndeterminate="True"/>
                                    <TextBlock Text="{x:Bind ViewModel.ZipLoadProgress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <InfoBar IsOpen="{x:Bind ViewModel.IsZipLoaded, Mode=OneWay}" Severity="Success" Title="Library Loaded">
                                    <InfoBar.Content>
                                        <TextBlock Margin="0,0,0,12">
                                            <Run Text="{x:Bind ViewModel.AvailableMaterialCount, Mode=OneWay}"/>
                                            <Run Text=" materials available"/>
                                        </TextBlock>
                                    </InfoBar.Content>
                                </InfoBar>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="Next: Material Assignment" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="Materials" IsEnabled="{x:Bind ViewModel.IsZipLoaded, Mode=OneWay}" Padding="24,12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Materials Content -->
                <ScrollViewer x:Name="MaterialsContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="0,0,16,24">
                    <Grid MinWidth="1120" MaxWidth="1600" ColumnSpacing="32" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> 
                            <RowDefinition Height="Auto"/> 
                            <RowDefinition Height="*"/>    
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                <TextBlock Text="Material Library" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.RunAutoMatchWrapperCommand}" Content="Auto Match" Style="{StaticResource AccentButtonStyle}"/>
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.AssignSelectedLibraryMaterialCommand}" Content="Assign"
                                        IsEnabled="{x:Bind ViewModel.CanAssignLibraryMaterial, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="Select a material, then select an object on the right and click Assign." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                            <ToggleSwitch OffContent="Zip Materials" OnContent="Game Library"
                                          IsOn="{x:Bind ViewModel.IsBrowserLibraryMode, Mode=TwoWay}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.BrowserLibraryGames}"
                                      SelectedItem="{x:Bind ViewModel.SelectedBrowserLibraryGame, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      Header="Game Library"
                                      Visibility="{x:Bind ViewModel.IsBrowserLibraryMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>


                        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto, Auto" Margin="0,0,0,12">
                            <Button Grid.Row="0" Content="Next: Configuration &amp; Export →"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right" Padding="24,12" Margin="0,0,0,12"
                                    Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="Config"/>
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock Text="Object-Specific Assignment" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="Select an object to override its material assignment." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>


                        <TextBox Grid.Row="1" Grid.Column="0"
                                 PlaceholderText="Search materials..."
                                 Text="{x:Bind ViewModel.BrowserSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12">
                            <TextBox.Header>
                                <FontIcon Glyph="&#xE721;" FontSize="12"/>
                            </TextBox.Header>
                        </TextBox>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 PlaceholderText="Search objects..."
                                 Text="{x:Bind ViewModel.GroupSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12">
                            <TextBox.Header>
                                <FontIcon Glyph="&#xE721;" FontSize="12"/>
                            </TextBox.Header>
                        </TextBox>


                        <ListView Grid.Row="2" Grid.Column="0"
                                  ItemsSource="{x:Bind ViewModel.BrowserActiveItems, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectedItem="{x:Bind ViewModel.BrowserSelectedItem, Mode=TwoWay}"
                                  MaxHeight="560"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="8"/>


                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.FilteredModelGroups, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGroupForMaterialAssignment, Mode=TwoWay}"
                                      MaxHeight="560"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:GroupViewModel">
                                        <StackPanel Padding="16,12">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind OriginalMaterial}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Grid.Column="1" MaxHeight="560" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                                <Grid>
                                    <TextBlock Text="Select an object to view its material" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                               Visibility="{x:Bind ViewModel.SelectedGroupForMaterialAssignment, Mode=OneWay, Converter={StaticResource NullToVis}, ConverterParameter='Invert'}"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{x:Bind ViewModel.SelectedGroupForMaterialAssignment, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                        <ListView ItemsSource="{x:Bind ViewModel.FilteredMaterialAssignments, Mode=OneWay}" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:MaterialAssignment">
                                                    <StackPanel Spacing="20">
                                                        <TextBlock Text="{x:Bind MeshName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords"/>
                                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords">
                                                            <Run Text="Source Material: "/>
                                                            <Run Text="{x:Bind SourceMaterialName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                        <ComboBox ItemsSource="{x:Bind AvailableMaterials, Mode=OneWay}" SelectedItem="{x:Bind SelectedMaterial, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Override material..."/>
                                                        <StackPanel Spacing="12">
                                                            <Button Command="{x:Bind EditParametersCommand}" Content="Edit Parameters"/>
                                                            <Button Command="{x:Bind ImportJsonCommand}" Content="Import JSON"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="ConfigContent"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="0,0,16,24">
                    <Grid MinWidth="1240" MaxWidth="1700" ColumnSpacing="32" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Bin Manager -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                            <TextBlock Text="Output modelbins" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,24"/>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.BinConfigs, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedBinConfig, Mode=TwoWay}"
                                      MinHeight="520"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ModelBinConfigViewModel">
                                        <TextBlock Text="{x:Bind OutputName}" Padding="16,12" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="2" Spacing="12">
                                <Button Command="{x:Bind ViewModel.AddBinCommand}" Content="Add New modelbin" HorizontalAlignment="Stretch"/>
                                <Button Command="{x:Bind ViewModel.RemoveBinCommand}" CommandParameter="{x:Bind ViewModel.SelectedBinConfig, Mode=OneWay}" Content="Remove Selected" HorizontalAlignment="Stretch" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Middle: Object Inclusion -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *">
                            <TextBlock Text="Included Objects" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,24"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                                <Button Content="Select All" Command="{x:Bind ViewModel.SelectAllInConfigCommand}"/>
                                <Button Content="Clear All" Command="{x:Bind ViewModel.DeselectAllInConfigCommand}"/>
                            </StackPanel>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredModelGroups, Mode=OneWay}"
                                      SelectionMode="Single"
                                      SelectedItem="{x:Bind ViewModel.SelectedConfigObject, Mode=TwoWay}"
                                      MinHeight="520"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:GroupViewModel">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Content="{x:Bind Name}" Margin="16,8"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Right: Bin Settings -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24" DataContext="{x:Bind ViewModel.SelectedBinConfig, Mode=OneWay}">
                                <TextBlock Text="Modelbin Configuration" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBox Header="Internal Name" Text="{Binding OutputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,0">
                                <StackPanel Spacing="32">
                                <!-- Global Transform -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel Spacing="20">
                                        <TextBlock Text="Global Transform" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="24">
                                            <Slider Value="{x:Bind ViewModel.GlobalResizePercentage, Mode=TwoWay}" Minimum="1" Maximum="200" StepFrequency="1"/>
                                            <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.GlobalResizePercentage, Mode=TwoWay}" Header="Scale %" Width="120" SpinButtonPlacementMode="Compact"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <NumberBox Header="Scale X" Value="{x:Bind ViewModel.GlobalScaleX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Column="1" Header="Scale Y" Value="{x:Bind ViewModel.GlobalScaleY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Column="2" Header="Scale Z" Value="{x:Bind ViewModel.GlobalScaleZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Row="1" Header="Pos X" Value="{x:Bind ViewModel.GlobalPosX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Row="1" Grid.Column="1" Header="Pos Y" Value="{x:Bind ViewModel.GlobalPosY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Row="1" Grid.Column="2" Header="Pos Z" Value="{x:Bind ViewModel.GlobalPosZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Mesh Options -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel Spacing="20">
                                        <TextBlock Text="Mesh Options" FontWeight="SemiBold"/>

                                        <TextBlock Text="Bucket Flags" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Select an object on the left to edit its bucket flags."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind ViewModel.SelectedConfigObject, Mode=OneWay, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16" RowSpacing="10"
                                              DataContext="{x:Bind ViewModel.SelectedConfigObject, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.SelectedConfigObject, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Opaque" IsChecked="{Binding IsOpaque, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Decal" IsChecked="{Binding IsDecal, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Transparent" IsChecked="{Binding IsTransparent, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Shadow" IsChecked="{Binding IsShadow, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="2" Grid.Column="0" Content="No Shadow" IsChecked="{Binding IsNotShadow, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="2" Grid.Column="1" Content="Alpha Coverage" IsChecked="{Binding IsAlphaToCoverage, Mode=TwoWay}"/>
                                            <CheckBox Grid.Row="3" Grid.Column="0" Content="Morph Damage" IsChecked="{Binding IsMorphDamage, Mode=TwoWay}"/>
                                        </Grid>

                                        <TextBlock Text="Modifiers" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                                        <StackPanel Spacing="8">
                                            <CheckBox Content="Mirror (X)" IsChecked="{x:Bind ViewModel.IsMirrorEnabled, Mode=TwoWay}"/>
                                            <CheckBox Content="Recalculate Normals" IsChecked="{x:Bind ViewModel.RecalculateNormals, Mode=TwoWay}"/>
                                            <CheckBox Content="Flip Faces" IsChecked="{x:Bind ViewModel.FlipFaces, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <TextBlock Text="Axis Flips" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                                        <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="32">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Position" FontSize="13" Margin="0,0,0,4"/>
                                                <CheckBox Content="Flip X" IsChecked="{x:Bind ViewModel.FlipVertexX, Mode=TwoWay}"/>
                                                <CheckBox Content="Flip Y" IsChecked="{x:Bind ViewModel.FlipVertexY, Mode=TwoWay}"/>
                                                <CheckBox Content="Flip Z" IsChecked="{x:Bind ViewModel.FlipVertexZ, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Normal" FontSize="13" Margin="0,0,0,4"/>
                                                <CheckBox Content="Flip X" IsChecked="{x:Bind ViewModel.FlipNormalX, Mode=TwoWay}"/>
                                                <CheckBox Content="Flip Y" IsChecked="{x:Bind ViewModel.FlipNormalY, Mode=TwoWay}"/>
                                                <CheckBox Content="Flip Z" IsChecked="{x:Bind ViewModel.FlipNormalZ, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="VLay Blob" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                                        <CheckBox Content="Advanced VLay Blob Patch" IsChecked="{x:Bind ViewModel.IsAdvancedVlayBlobPatchEnabled, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Resolves required vertex elements from the target game's materialbins and shaderbins. Slower; requires a configured game path in Setup."/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Spacing="12" Margin="0,24,0,0">
                                <InfoBar IsOpen="True" IsClosable="False"
                                         Severity="{x:Bind ViewModel.ExportReadinessSeverity, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.ExportReadinessMessage, Mode=OneWay}"/>
                                <Button Command="{x:Bind ViewModel.ConvertModelCommand}" IsEnabled="{x:Bind ViewModel.IsReadyToExport, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="56">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

    </Grid>
</Page>

