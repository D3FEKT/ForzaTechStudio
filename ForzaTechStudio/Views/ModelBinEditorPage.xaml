<Page
    x:Class="ForzaTechStudio.Views.ModelBinEditorPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTechStudio.Views"
    xmlns:vm="using:ForzaTechStudio.ViewModels"
    xmlns:helpers="using:ForzaTechStudio.Helpers"
    xmlns:blobs="using:ForzaTools.Bundles.Blobs"
    xmlns:converters="using:ForzaTechStudio.Converters"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">


    <Page.Resources>
        <!-- - Converters - -->
        <converters:NameHashConverter x:Key="NameHashConverter"/>
        <local:NullToBoolConverter x:Key="NullToFalseConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Inverse="True"/>
        <converters:BlobTypeIconConverter  x:Key="BlobIconConv"/>
        <converters:BlobTypeColorConverter x:Key="BlobColorConv"/>
        <converters:BooleanNegationConverter x:Key="BoolNegConverter"/>
        <converters:IntToDoubleConverter x:Key="IntToDoubleConv"/>

        <!-- - Shared card / section styles - -->
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background"       Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"      Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="8"/>
            <Setter Property="Padding"          Value="16"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>

        <Style x:Key="HDivStyle" TargetType="Border">
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Background"  Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin"      Value="0,4,0,8"/>
        </Style>

        <!-- Subtle section label for grouping inside a card -->
        <Style x:Key="SubSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity"    Value="0.5"/>
            <Setter Property="Margin"     Value="0,10,0,4"/>
            <Setter Property="CharacterSpacing" Value="100"/>
        </Style>

        <!-- Read-only badge chip for FourCC tags -->
        <Style x:Key="TagBadgeStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource AccentFillColorTertiaryBrush}"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6,2"/>
        </Style>

        <!-- Property row label -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Opacity"           Value="0.65"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Monospace read-only value -->
        <Style x:Key="PropReadOnly" TargetType="TextBlock">
            <Setter Property="FontFamily"              Value="Cascadia Code, Consolas"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="IsTextSelectionEnabled"  Value="True"/>
            <Setter Property="VerticalAlignment"       Value="Center"/>
            <Setter Property="Opacity"                 Value="0.85"/>
        </Style>

        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="MinHeight"  Value="30"/>
            <Setter Property="Padding"    Value="8,4"/>
        </Style>

        <!-- - Property-item micro-templates - -->

        <!-- Bool: ToggleSwitch -->
        <DataTemplate x:Key="PropBoolTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}" Margin="0,4,0,0"/>
                <ToggleSwitch Grid.Column="1"
                              IsOn="{x:Bind BoolValue, Mode=TwoWay}"
                              IsEnabled="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"
                              OnContent="" OffContent=""
                              MinWidth="0" Padding="0"
                              VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Float: NumberBox -->
        <DataTemplate x:Key="PropFloatTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <NumberBox Grid.Column="1"
                           Value="{x:Bind FloatValue, Mode=TwoWay}"
                           IsEnabled="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"
                           SmallChange="0.0001" LargeChange="0.1"
                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
            </Grid>
        </DataTemplate>

        <!-- Int: NumberBox (integer) -->
        <DataTemplate x:Key="PropIntTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <NumberBox Grid.Column="1"
                           Value="{x:Bind IntValue, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                           IsEnabled="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"
                           SmallChange="1" LargeChange="10"
                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
            </Grid>
        </DataTemplate>

        <!-- UInt: NumberBox (unsigned integer) -->
        <DataTemplate x:Key="PropUIntTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <NumberBox Grid.Column="1"
                           Value="{x:Bind IntValue, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                           IsEnabled="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"
                           SmallChange="1" Minimum="0"
                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
            </Grid>
        </DataTemplate>

        <!-- String: TextBox -->
        <DataTemplate x:Key="PropStringTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{x:Bind ValueAsString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{x:Bind IsReadOnly, Mode=OneWay}"
                         Style="{StaticResource PropTextBox}"/>
            </Grid>
        </DataTemplate>

        <!-- Enum: ComboBox -->
        <DataTemplate x:Key="PropEnumTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Bind EnumItems, Mode=OneWay}"
                          SelectedItem="{x:Bind EnumSelectedValue, Mode=TwoWay}"
                          IsEnabled="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"
                          HorizontalAlignment="Stretch" MinWidth="0"/>
            </Grid>
        </DataTemplate>

        <!-- Tag4CC: read-only badge -->
        <DataTemplate x:Key="PropTagTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,8" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{StaticResource TagBadgeStyle}">
                        <TextBlock Text="{x:Bind TagString, Mode=OneWay}"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{x:Bind ValueAsString, Mode=OneWay}"
                               Style="{StaticResource PropReadOnly}" Opacity="0.45"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- HexUInt: read-only hex display formatted as 0xXXXXXXXX -->
        <DataTemplate x:Key="PropHexTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ValueAsString, Mode=OneWay}"
                           Style="{StaticResource PropReadOnly}"/>
            </Grid>
        </DataTemplate>

        <!-- ReadOnly fallback: selectable TextBlock -->
        <DataTemplate x:Key="PropReadOnlyTemplate" x:DataType="vm:PropertyItem">
            <Grid Margin="0,2,0,4" ColumnSpacing="12" ColumnDefinitions="180,*">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ValueAsString, Mode=OneWay}"
                           Style="{StaticResource PropReadOnly}"/>
            </Grid>
        </DataTemplate>

        <!-- Vector4: 4 compact NumberBoxes -->
        <DataTemplate x:Key="PropVector4Template" x:DataType="vm:PropertyItem">
            <StackPanel Margin="0,2,0,8" Spacing="4">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <Grid ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                    <NumberBox Header="X" Value="{x:Bind VecX, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind VecY, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind VecZ, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="3" Header="W" Value="{x:Bind VecW, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Vector3: 3 compact NumberBoxes -->
        <DataTemplate x:Key="PropVector3Template" x:DataType="vm:PropertyItem">
            <StackPanel Margin="0,2,0,8" Spacing="4">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <Grid ColumnSpacing="6" ColumnDefinitions="*,*,*">
                    <NumberBox Header="X" Value="{x:Bind VecX, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind VecY, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind VecZ, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Vector2: 2 compact NumberBoxes -->
        <DataTemplate x:Key="PropVector2Template" x:DataType="vm:PropertyItem">
            <StackPanel Margin="0,2,0,8" Spacing="4">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource PropLabel}"/>
                <Grid ColumnSpacing="6" ColumnDefinitions="*,*">
                    <NumberBox Header="X" Value="{x:Bind VecX, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                    <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind VecY, Mode=TwoWay}"
                               SmallChange="0.001"
                               SpinButtonPlacementMode="Compact" MinWidth="0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- The unified PropertyItem template selector -->
        <helpers:PropertyItemTemplateSelector x:Key="PropertyItemSelector"
            BoolTemplate     ="{StaticResource PropBoolTemplate}"
            FloatTemplate    ="{StaticResource PropFloatTemplate}"
            IntTemplate      ="{StaticResource PropIntTemplate}"
            UIntTemplate     ="{StaticResource PropUIntTemplate}"
            StringTemplate   ="{StaticResource PropStringTemplate}"
            TagTemplate      ="{StaticResource PropTagTemplate}"
            EnumTemplate     ="{StaticResource PropEnumTemplate}"
            Vector4Template  ="{StaticResource PropVector4Template}"
            Vector3Template  ="{StaticResource PropVector3Template}"
            Vector2Template  ="{StaticResource PropVector2Template}"
            HexTemplate      ="{StaticResource PropHexTemplate}"
            ReadOnlyTemplate ="{StaticResource PropReadOnlyTemplate}"/>

        <!-- - BLOB DETAIL TEMPLATES - -->

        <!-- - BLOB DETAIL TEMPLATES - -->

        <!-- +-+
             �  DEFAULT / GENERIC BLOB                                      �
             +-+ -->
        <DataTemplate x:Key="DefaultBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="4">
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HDivStyle}"/>
                            <ItemsControl ItemsSource="{x:Bind Properties, Mode=OneWay}"
                                          ItemTemplateSelector="{StaticResource PropertyItemSelector}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  MESH BLOB  (Mesh / 0x4D657368)                             �
             +-+ -->
        <DataTemplate x:Key="MeshBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="12">

                    <!-- - Material & Bone - -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xF158;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HDivStyle}"/>

                            <TextBlock Text="MATERIAL &amp; BONE" Style="{StaticResource SubSectionLabel}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox Header="Material ID"
                                           Value="{Binding Data.MaterialId, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                <NumberBox Grid.Column="1" Header="Rigid Bone Index"
                                           Value="{Binding Data.RigidBoneIndex, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                            </Grid>

                            <!-- LOD Flags -->
                            <TextBlock Text="LOD FLAGS" Style="{StaticResource SubSectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch Header="Has LODS"     IsOn="{Binding Data.LOD_LODS, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 0 (near)" IsOn="{Binding Data.LOD_LOD0, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 1"        IsOn="{Binding Data.LOD_LOD1, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 2"        IsOn="{Binding Data.LOD_LOD2, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 3"        IsOn="{Binding Data.LOD_LOD3, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 4"        IsOn="{Binding Data.LOD_LOD4, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Header="LOD 5 (far)"  IsOn="{Binding Data.LOD_LOD5, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                            </StackPanel>

                            <!-- Bucket Flags -->
                            <TextBlock Text="BUCKET FLAGS" Style="{StaticResource SubSectionLabel}"/>
                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleSwitch Grid.Row="0" Grid.Column="0" Header="Opaque"           IsOn="{Binding Data.IsOpaque, Mode=TwoWay}"          OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Grid.Row="0" Grid.Column="1" Header="Decal"            IsOn="{Binding Data.IsDecal, Mode=TwoWay}"           OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Grid.Row="0" Grid.Column="2" Header="Transparent"      IsOn="{Binding Data.IsTransparent, Mode=TwoWay}"     OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="Shadow"           IsOn="{Binding Data.IsShadow, Mode=TwoWay}"          OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Not Shadow"       IsOn="{Binding Data.IsNotShadow, Mode=TwoWay}"       OnContent="" OffContent="" MinWidth="0"/>
                                <ToggleSwitch Grid.Row="1" Grid.Column="2" Header="Alpha To Coverage" IsOn="{Binding Data.IsAlphaToCoverage, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- - Position Transforms - -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="POSITION TRANSFORMS" Style="{StaticResource SubSectionLabel}" Margin="0,0,0,8"/>

                            <TextBlock Text="Scale (X Y Z W)" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                            <Grid ColumnSpacing="8" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
                                <NumberBox Header="X" Value="{x:Bind MeshWrapper.ScaleX, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind MeshWrapper.ScaleY, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind MeshWrapper.ScaleZ, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="3" Header="W" Value="{x:Bind MeshWrapper.ScaleW, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>

                            <TextBlock Text="Translate (X Y Z W)" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                            <Grid ColumnSpacing="8" ColumnDefinitions="*,*,*,*">
                                <NumberBox Header="X" Value="{x:Bind MeshWrapper.TransX, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind MeshWrapper.TransY, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind MeshWrapper.TransZ, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="3" Header="W" Value="{x:Bind MeshWrapper.TransW, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- - UV Coord Transforms (v1.5+) - -->
                    <Border Style="{StaticResource DetailCardStyle}"
                            Visibility="{x:Bind MeshWrapper.HasTexCoordTransforms, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="UV COORD TRANSFORMS" Style="{StaticResource SubSectionLabel}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{x:Bind MeshWrapper.TexCoordTransforms, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TexCoordTransformViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="4">
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource PropLabel}"/>
                                            <Grid ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                                                <NumberBox Header="X" Value="{x:Bind X, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind Y, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind Z, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                <NumberBox Grid.Column="3" Header="W" Value="{x:Bind W, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- - Other Mesh Properties - -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="OTHER PROPERTIES" Style="{StaticResource SubSectionLabel}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{x:Bind Properties, Mode=OneWay}"
                                          ItemTemplateSelector="{StaticResource PropertyItemSelector}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  MODEL BLOB  (Modl / 0x4D6F646C)                           �
             +-+ -->
        <DataTemplate x:Key="ModelBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE81F;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HDivStyle}"/>

                            <!-- Counts -->
                            <TextBlock Text="COUNTS" Style="{StaticResource SubSectionLabel}"/>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <NumberBox Grid.Row="0" Grid.Column="0" Header="Meshes"
                                           Value="{Binding Data.MeshCount, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="1" Header="Buffers"
                                           Value="{Binding Data.BuffersCount, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="0" Header="Vertex Layouts"
                                           Value="{Binding Data.VertexLayoutCount, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="Materials"
                                           Value="{Binding Data.MaterialCount, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"/>
                            </Grid>

                            <!-- LOD -->
                            <TextBlock Text="LEVEL OF DETAIL" Style="{StaticResource SubSectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                <ToggleSwitch Header="Has LOD" IsOn="{Binding Data.HasLOD, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="0"/>
                            </StackPanel>
                            <Grid ColumnSpacing="12" ColumnDefinitions="*,*">
                                <NumberBox Header="Min LOD"
                                           Value="{Binding Data.MinLOD, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"
                                           Minimum="-128" Maximum="127"/>
                                <NumberBox Grid.Column="1" Header="Max LOD"
                                           Value="{Binding Data.MaxLOD, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                           SpinButtonPlacementMode="Inline" MinWidth="0"
                                           Minimum="-128" Maximum="127"/>
                            </Grid>

                            <!-- Other props -->
                            <TextBlock Text="OTHER PROPERTIES" Style="{StaticResource SubSectionLabel}"/>
                            <ItemsControl ItemsSource="{x:Bind Properties, Mode=OneWay}"
                                          ItemTemplateSelector="{StaticResource PropertyItemSelector}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  SKELETON BLOB  (Skel / 0x536B656C)                        �
             +-+ -->
        <DataTemplate x:Key="SkeletonBlobTemplate" x:DataType="vm:ObjectNode">
            <Grid RowDefinitions="Auto,*">
                <!-- Header strip -->
                <Border Grid.Row="0" Padding="20,12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A4;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Command="{x:Bind SkeletonBlobWrapper.AddBoneCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <SymbolIcon Symbol="Add"/>
                                    <TextBlock Text="Add Bone" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind SkeletonBlobWrapper.DeleteBoneCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    <TextBlock Text="Delete Bone" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bone list + matrix editor -->
                <Grid Grid.Row="1" ColumnDefinitions="260,*">
                    <!-- Bone list -->
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0">
                        <ListView ItemsSource="{x:Bind SkeletonBlobWrapper.Bones, Mode=OneWay}"
                                  SelectedItem="{x:Bind SkeletonBlobWrapper.SelectedBone, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="blobs:Bone">
                                    <TextBlock Text="{x:Bind Name}" Margin="0,3" FontSize="12"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Bone detail panel -->
                    <ScrollViewer Grid.Column="1" Padding="20,16"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="BONE PROPERTIES" Style="{StaticResource SubSectionLabel}" Margin="0"/>

                            <TextBox Header="Name"
                                     Text="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,4">
                                <NumberBox Grid.Column="0" Header="Parent Index"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.ParentId, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="1" Header="First Child Index"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.FirstChildIndex, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="2" Header="Next Index"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.NextIndex, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,4">
                                <TextBlock Text="TRANSFORM MATRIX (row-major)" Style="{StaticResource SubSectionLabel}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Command="{x:Bind SkeletonBlobWrapper.CopyBoneMatrixCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                            <TextBlock Text="Copy Bone Matrix" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind SkeletonBlobWrapper.PasteBoneMatrixCommand}"
                                            IsEnabled="{x:Bind SkeletonBlobWrapper.HasCopiedMatrix, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                            <TextBlock Text="Paste Bone Matrix" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Row 0 -->
                                <NumberBox Grid.Row="0" Grid.Column="0" Header="M11"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M11, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="1" Header="M12"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M12, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="2" Header="M13"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M13, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="3" Header="M14"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M14, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <!-- Row 1 -->
                                <NumberBox Grid.Row="1" Grid.Column="0" Header="M21"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M21, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="M22"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M22, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="2" Header="M23"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M23, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="3" Header="M24"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M24, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <!-- Row 2 -->
                                <NumberBox Grid.Row="2" Grid.Column="0" Header="M31"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M31, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="1" Header="M32"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M32, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="2" Header="M33"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M33, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="3" Header="M34"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M34, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <!-- Row 3 -->
                                <NumberBox Grid.Row="3" Grid.Column="0" Header="M41"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M41, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="1" Header="M42"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M42, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="2" Header="M43"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M43, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="3" Header="M44"
                                           Value="{x:Bind SkeletonBlobWrapper.SelectedBoneVm.M44, Mode=TwoWay}"
                                           SmallChange="0.001"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- +-+
             �  VERTEX LAYOUT BLOB  (VLay / ILay)                         �
             +-+ -->
        <!-- +-+     |  VERTEX LAYOUT DETAIL  (shared – tree view & simple view)  |     +-+ -->
        <DataTemplate x:Key="VLayBlobDetailTemplate" x:DataType="vm:VLayBlobViewModel">
            <StackPanel Spacing="12">

                <!-- Card 1 · Linked Materials -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xF158;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="LINKED MATERIALS" Style="{StaticResource SubSectionLabel}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Meshes that reference this vertex layout and their assigned materials:"
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Visibility="{x:Bind HasLinkedMaterials, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{x:Bind LinkedMaterials, Mode=OneWay}"
                                      Visibility="{x:Bind HasLinkedMaterials, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               FontSize="12"
                                               FontFamily="Cascadia Code, Consolas"
                                               IsTextSelectionEnabled="True"
                                               Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No meshes reference this vertex layout."
                                   FontSize="12" Opacity="0.45" FontStyle="Italic"
                                   Visibility="{x:Bind HasLinkedMaterials, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2 · Flags -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA5C;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ContextName, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Command="{x:Bind SaveToLibraryCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                                        <TextBlock Text="Save to Library" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind LoadFromLibraryCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                        <TextBlock Text="Load from Library" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind RecomputeFlagsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Recompute Flags" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource HDivStyle}"/>

                        <TextBlock Text="FLAGS" Style="{StaticResource SubSectionLabel}"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,0,8">
                            <NumberBox Grid.Column="0"
                                       Header="Raw Flags (uint32)"
                                       Value="{x:Bind RawFlags, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                       SpinButtonPlacementMode="Compact" Width="160"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Hex" Style="{StaticResource PropLabel}"/>
                                <TextBlock Text="{x:Bind FlagsHex, Mode=OneWay}"
                                           Style="{StaticResource PropReadOnly}"/>
                                <TextBlock Text="{x:Bind FlagsDescription, Mode=OneWay}"
                                           FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active channel chips -->
                        <TextBlock Text="ACTIVE CHANNELS" Style="{StaticResource SubSectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" FlowDirection="LeftToRight">
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTexCoord0, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TC0" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTexCoord1, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TC1" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTexCoord2, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TC2" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTexCoord3, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TC3" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTexCoord4, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TC4" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTangent0OrTC5, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TAN0" FontSize="11" ToolTipService.ToolTip="bit 5 — shared with TC5 (extremely rare)"/>
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTangent1, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TAN1" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagTangent2, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TAN2" FontSize="11"/>
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind FlagColor0, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="COLOR0" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3 · Semantic Names -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="SEMANTIC NAMES"
                                       Style="{StaticResource SubSectionLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1"
                                    Command="{x:Bind AddSemanticNameCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add"/>
                                    <TextBlock Text="Add" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource HDivStyle}"/>
                        <ItemsControl ItemsSource="{x:Bind SemanticNames, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VLaySemanticNameViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                                        <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="Cascadia Code, Consolas" FontSize="12"/>
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Opacity="0.7">
                                                <Run Text="used by "/>
                                                <Run Text="{x:Bind UsageCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="2"
                                                Command="{x:Bind RemoveCommand}"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 4 · Elements -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="VERTEX ELEMENTS"
                                       Style="{StaticResource SubSectionLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1"
                                    Command="{x:Bind AddElementCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add"/>
                                    <TextBlock Text="Add Element" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource HDivStyle}"/>
                        <ItemsControl ItemsSource="{x:Bind Elements, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VLayElementViewModel">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <StackPanel Spacing="8">
                                            <!-- Row 1: label + remove -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                            CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FlagBit, Mode=OneWay}" FontSize="10"
                                                                   FontFamily="Cascadia Code, Consolas"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{x:Bind RemoveCommand}" Padding="6,4">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                            <!-- Row 2: Semantic fields -->
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                <NumberBox Header="Semantic Index"
                                                           Value="{x:Bind SemanticIndex, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                                           Minimum="0" Maximum="15"
                                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                <NumberBox Grid.Column="1" Header="Input Slot"
                                                           Value="{x:Bind InputSlot, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                                           Minimum="0" Maximum="7"
                                                           SpinButtonPlacementMode="Compact" MinWidth="0" Width="110"/>
                                                <NumberBox Grid.Column="2" Header="Inst. Step Rate"
                                                           Value="{x:Bind InstanceDataStepRate, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                                           Minimum="0"
                                                           SpinButtonPlacementMode="Compact" MinWidth="0" Width="110"/>
                                                <ToggleSwitch Grid.Column="3" Header="Auto Offset"
                                                              IsOn="{x:Bind IsAutoAligned, Mode=TwoWay}"
                                                              OnContent="" OffContent="" MinWidth="0"
                                                              ToolTipService.ToolTip="-1 = D3D12_APPEND_ALIGNED_ELEMENT"/>
                                            </Grid>
                                            <!-- Row 3: Format + offset -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="DXGI Format" Style="{StaticResource PropLabel}"/>
                                                    <TextBlock Text="{x:Bind Format, Mode=OneWay}"
                                                               Style="{StaticResource PropReadOnly}"/>
                                                </StackPanel>
                                                <NumberBox Grid.Column="1" Header="Byte Offset"
                                                           Value="{x:Bind AlignedByteOffset, Mode=TwoWay, Converter={StaticResource IntToDoubleConv}}"
                                                           Minimum="-1" Maximum="1024"
                                                           SpinButtonPlacementMode="Compact" MinWidth="0" Width="130"
                                                           IsEnabled="{x:Bind IsAutoAligned, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>


            </StackPanel>
        </DataTemplate>

        <!-- +-+
             |  VERTEX LAYOUT BLOB  (VLay / ILay)                         |
             +-+ -->
        <DataTemplate x:Key="VertexLayoutBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <ContentPresenter Content="{x:Bind VLayBlobWrapper, Mode=OneWay}"
                                  ContentTemplate="{StaticResource VLayBlobDetailTemplate}"/>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  BUFFER HEADER-ONLY  (VerB / IndB / MBuf / Skin)           �
             +-+ -->
        <DataTemplate x:Key="BufferBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="12">

                    <!-- Info banner -->
                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="0,0,0,2" CornerRadius="6" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12">
                                Raw buffer data is not displayed to avoid loading large byte arrays.
                                Only the structural header is shown below.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Blob header properties -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE838;" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorNeutralBrush}"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HDivStyle}"/>
                            <TextBlock Text="BLOB HEADER" Style="{StaticResource SubSectionLabel}"/>
                            <ItemsControl ItemsSource="{x:Bind Properties, Mode=OneWay}"
                                          ItemTemplateSelector="{StaticResource PropertyItemSelector}"/>

                            <!-- Buffer header sub-section -->
                            <TextBlock Text="BUFFER HEADER" Style="{StaticResource SubSectionLabel}"/>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Element Count" Style="{StaticResource PropLabel}"/>
                                    <TextBlock Text="{Binding Data.Header.Length, Mode=OneWay}"
                                               Style="{StaticResource PropReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Total Bytes" Style="{StaticResource PropLabel}"/>
                                    <TextBlock Text="{Binding Data.Header.Size, Mode=OneWay}"
                                               Style="{StaticResource PropReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Stride (bytes/elem)" Style="{StaticResource PropLabel}"/>
                                    <TextBlock Text="{Binding Data.Header.Stride, Mode=OneWay}"
                                               Style="{StaticResource PropReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Sub-Element Count" Style="{StaticResource PropLabel}"/>
                                    <TextBlock Text="{Binding Data.Header.SubElementCount, Mode=OneWay}"
                                               Style="{StaticResource PropReadOnly}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                    <TextBlock Text="Format (DXGI)" Style="{StaticResource PropLabel}"/>
                                    <TextBlock Text="{Binding Data.Header.Format, Mode=OneWay}"
                                               Style="{StaticResource PropReadOnly}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  MATERIAL SHADER PARAMETER BLOB  (MTPR / DFPR)             �
             +-+ -->
        <DataTemplate x:Key="MaterialShaderParameterTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.ViewKnownParametersCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="List"/>
                                            <TextBlock Text="Reference" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.AddShaderParameterCommand}"
                                            CommandParameter="{Binding Data, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Add"/>
                                            <TextBlock Text="Add Parameter" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HDivStyle}"/>
                            <controls:MaterialParameterEditorView
                                ParametersSource="{Binding Data.Parameters, Mode=OneWay, FallbackValue={x:Null}}"
                                RemoveParameterCommand="{Binding ElementName=PageRoot, Path=ViewModel.RemoveShaderParameterCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             �  MATERIAL BLOB  (MatI / MATI � with JSON/library actions)  �
             +-+ -->
        <DataTemplate x:Key="MaterialBlobTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16">
                <StackPanel Spacing="12">

                    <!-- Card 1 · Identity -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <!-- Header bar: icon + title + action buttons -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE771;" FontSize="16"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.SaveMaterialToJsonCommand}"
                                            CommandParameter="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Save"/>
                                            <TextBlock Text="Save JSON" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.ReplaceMaterialFromJsonCommand}"
                                            CommandParameter="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Import"/>
                                            <TextBlock Text="Replace JSON" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.BrowseMaterialLibraryCommand}"
                                            CommandParameter="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Library"/>
                                            <TextBlock Text="Library" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HDivStyle}"/>

                            <!-- Identity fields -->
                            <TextBlock Text="IDENTITY" Style="{StaticResource SubSectionLabel}"/>
                            <!-- Material name (read-only badge) -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind MaterialBlobWrapper.Name, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Material ID + Path in a 2-row grid -->
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8" Margin="0,0,0,10">
                                <NumberBox Grid.Row="0" Grid.Column="0"
                                           Header="Material ID"
                                           Value="{x:Bind MaterialBlobWrapper.MaterialId, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact"
                                           Width="160"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Header="Material Path"
                                         Text="{x:Bind MaterialBlobWrapper.MaterialPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 · Shader Parameters -->
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SHADER PARAMETERS"
                                           Style="{StaticResource SubSectionLabel}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="1"
                                        Command="{Binding ElementName=PageRoot, Path=ViewModel.AddShaderParameterCommand}"
                                        CommandParameter="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Add"/>
                                        <TextBlock Text="Add Parameter" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <controls:MaterialParameterEditorView
                                ParametersSource="{x:Bind MaterialBlobWrapper.Parameters, Mode=OneWay}"
                                RemoveParameterCommand="{x:Bind MaterialBlobWrapper.RemoveParameterCommand}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- +-+
             |  BONE NODE  (individual Bone item from Bones collection)    |
             +-+ -->
        <DataTemplate x:Key="BoneNodeTemplate" x:DataType="vm:ObjectNode">
            <ScrollViewer Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource DetailCardStyle}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE8A4;" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HDivStyle}"/>

                            <TextBlock Text="BONE PROPERTIES" Style="{StaticResource SubSectionLabel}"/>
                            <TextBox Header="Name"
                                     Text="{x:Bind BoneWrapper.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,8">
                                <NumberBox Grid.Column="0" Header="Parent Index"
                                           Value="{x:Bind BoneWrapper.ParentId, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="1" Header="First Child Index"
                                           Value="{x:Bind BoneWrapper.FirstChildIndex, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Column="2" Header="Next Index"
                                           Value="{x:Bind BoneWrapper.NextIndex, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,4">
                                <TextBlock Text="TRANSFORM MATRIX (row-major)" Style="{StaticResource SubSectionLabel}"
                                           VerticalAlignment="Center" Margin="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Command="{x:Bind BoneWrapper.CopyMatrixCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                            <TextBlock Text="Copy Bone Matrix" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind BoneWrapper.PasteMatrixCommand}"
                                            IsEnabled="{x:Bind BoneWrapper.HasCopiedMatrix, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                            <TextBlock Text="Paste Bone Matrix" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <NumberBox Grid.Row="0" Grid.Column="0" Header="M11" Value="{x:Bind BoneWrapper.M11, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="1" Header="M12" Value="{x:Bind BoneWrapper.M12, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="2" Header="M13" Value="{x:Bind BoneWrapper.M13, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="0" Grid.Column="3" Header="M14" Value="{x:Bind BoneWrapper.M14, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="0" Header="M21" Value="{x:Bind BoneWrapper.M21, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="M22" Value="{x:Bind BoneWrapper.M22, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="2" Header="M23" Value="{x:Bind BoneWrapper.M23, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="1" Grid.Column="3" Header="M24" Value="{x:Bind BoneWrapper.M24, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="0" Header="M31" Value="{x:Bind BoneWrapper.M31, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="1" Header="M32" Value="{x:Bind BoneWrapper.M32, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="2" Header="M33" Value="{x:Bind BoneWrapper.M33, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="2" Grid.Column="3" Header="M34" Value="{x:Bind BoneWrapper.M34, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="0" Header="M41" Value="{x:Bind BoneWrapper.M41, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="1" Header="M42" Value="{x:Bind BoneWrapper.M42, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="2" Header="M43" Value="{x:Bind BoneWrapper.M43, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                <NumberBox Grid.Row="3" Grid.Column="3" Header="M44" Value="{x:Bind BoneWrapper.M44, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- - Blob template selector - -->
        <helpers:BlobTemplateSelector x:Key="BlobTemplateSelector"
            DefaultTemplate                 ="{StaticResource DefaultBlobTemplate}"
            MeshTemplate                    ="{StaticResource MeshBlobTemplate}"
            ModelTemplate                   ="{StaticResource ModelBlobTemplate}"
            SkeletonTemplate                ="{StaticResource SkeletonBlobTemplate}"
            VertexLayoutTemplate            ="{StaticResource VertexLayoutBlobTemplate}"
            BufferTemplate                  ="{StaticResource BufferBlobTemplate}"
            MaterialTemplate                ="{StaticResource MaterialBlobTemplate}"
            MaterialShaderParameterTemplate ="{StaticResource MaterialShaderParameterTemplate}"
            BoneNodeTemplate                ="{StaticResource BoneNodeTemplate}"/>
    </Page.Resources>

    <Grid Padding="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Page Header with Commands -->
        <controls:StandardPageHeader Grid.Row="0" 
                                     Title="Modelbin Viewer" 
                                     Description="View and edit .modelbin files"
                                     Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.OpenFilesCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SaveFileCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SaveFileAsCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CloseSimpleFileCommand}"
                   CommandParameter="{x:Bind ViewModel.SelectedFile, Mode=OneWay}"
                   Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close File"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CloseAllFilesCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Close All"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.UndoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                            <TextBlock Text="Undo"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.RedoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14"/>
                            <TextBlock Text="Redo"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Y"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>
                    
                    <TextBlock Text="{x:Bind ViewModel.SelectedFileTitle, Mode=OneWay}" 
                               VerticalAlignment="Center" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Tab strip -->
        <Grid Grid.Row="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,1"
              Margin="0,0,0,12"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="ModelBinAddTabBtn"
                    Command="{x:Bind ViewModel.OpenFilesCommand}"
                    Width="28" Height="28"
                    Padding="0" CornerRadius="4"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Open file">
                <FontIcon Glyph="&#xE710;" FontSize="11"/>
            </Button>
            <ListView Grid.Column="1"
                      x:Name="ModelBinTabListView"
                      ItemsSource="{x:Bind ViewModel.LoadedFiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12"/>
                            <Button Click="ModelBinTabClose_Click"
                                    Tag="{x:Bind}"
                                    Width="18" Height="18"
                                    Padding="0"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="9"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- - Empty state - -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsContentEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <FontIcon Glyph="&#xE8E5;" FontSize="52"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="Drag &amp; drop a .modelbin file here, or use Open"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Pivot Grid.Row="2" SelectedIndex="{x:Bind ViewModel.SelectedViewIndex, Mode=TwoWay}"
               Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <PivotItem Header="Simple View">
                <!-- Simple View Panel -->
                <Grid x:Name="SimpleViewPanel">
                    <ScrollViewer Padding="24,16">
                        <StackPanel Spacing="32">
                            <!-- Materials Section -->
                            <StackPanel Spacing="16">
                                <TextBlock Text="Materials" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SimpleMaterials, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SimpleMaterialViewModel">
                                            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                <Expander.Header>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" FontSize="12">
                                                            <Run Text="(Material ID = "/>
                                                            <Run Text="{Binding MaterialId}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{x:Bind MaterialPath, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Opacity="0.6"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <NumberBox Grid.Row="0" Grid.Column="0" 
                                                                 Header="Material ID" 
                                                                 Value="{x:Bind MaterialId, Mode=TwoWay}" 
                                                                 SpinButtonPlacementMode="Inline"
                                                                 Width="150"
                                                                 VerticalAlignment="Top"/>
                                                            
                                                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                 Header="Material Path"
                                                                 Text="{x:Bind MaterialPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 HorizontalAlignment="Stretch"/>

                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                            <Button Command="{x:Bind AddParameterCommand}" CommandParameter="{x:Bind Blob, Mode=OneWay}">
                                                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                                                     <SymbolIcon Symbol="Add"/>
                                                                     <TextBlock Text="Add Parameter"/>
                                                                 </StackPanel>
                                                            </Button>
                                                            <Button Command="{x:Bind SaveJsonCommand}" CommandParameter="{x:Bind Blob, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <SymbolIcon Symbol="Save"/>
                                                                    <TextBlock Text="Save to JSON"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{x:Bind ReplaceJsonCommand}" CommandParameter="{x:Bind Blob, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <SymbolIcon Symbol="Import"/>
                                                                    <TextBlock Text="Replace JSON"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{x:Bind BrowseLibraryCommand}" CommandParameter="{x:Bind Blob, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <SymbolIcon Symbol="Library"/>
                                                                    <TextBlock Text="Browse Library"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                

                                                    <controls:MaterialParameterEditorView 
                                                        ParametersSource="{x:Bind Parameters, Mode=OneWay}"
                                                        RemoveParameterCommand="{x:Bind RemoveParameterCommand}"/>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Skeleton Section -->
                            <StackPanel Spacing="16">
                                 <TextBlock Text="Skeleton" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                 <ItemsControl ItemsSource="{x:Bind ViewModel.SimpleSkeletons, Mode=OneWay}">
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate x:DataType="vm:SimpleSkeletonViewModel">
                                             <Expander HorizontalAlignment="Stretch" Header="Skeleton Data">
                                                <Grid Height="400" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="250"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Grid RowDefinitions="Auto,*">
                                                         <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="8,6"
                                                                     Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                             <Button Command="{x:Bind AddBoneCommand}" Padding="8,4">
                                                                 <StackPanel Orientation="Horizontal" Spacing="4">
                                                                     <SymbolIcon Symbol="Add"/>
                                                                     <TextBlock Text="Add" FontSize="12"/>
                                                                 </StackPanel>
                                                             </Button>
                                                             <Button Command="{x:Bind DeleteBoneCommand}" Padding="8,4">
                                                                 <StackPanel Orientation="Horizontal" Spacing="4">
                                                                     <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                                     <TextBlock Text="Delete" FontSize="12"/>
                                                                 </StackPanel>
                                                             </Button>
                                                         </StackPanel>
                                                         <ListView Grid.Row="1" ItemsSource="{x:Bind Bones}" SelectedItem="{x:Bind SelectedBone, Mode=TwoWay}" SelectionMode="Single">
                                                             <ListView.ItemTemplate>
                                                                 <DataTemplate x:DataType="blobs:Bone">
                                                                     <TextBlock Text="{x:Bind Name}" Margin="0,4"/>
                                                                 </DataTemplate>
                                                             </ListView.ItemTemplate>
                                                         </ListView>
                                                     </Grid>
                                                     <ScrollViewer Grid.Column="1" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                     <StackPanel Spacing="12">
                                                         <TextBlock Text="Bone Properties" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                         <TextBox Header="Name" Text="{x:Bind SelectedBoneVm.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                                         <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,4">
                                                             <NumberBox Grid.Column="0" Header="Parent Index" Value="{x:Bind SelectedBoneVm.ParentId, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                             <NumberBox Grid.Column="1" Header="First Child" Value="{x:Bind SelectedBoneVm.FirstChildIndex, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                             <NumberBox Grid.Column="2" Header="Next Index" Value="{x:Bind SelectedBoneVm.NextIndex, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                         </Grid>
                                                         
                                                         <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,2">
                                                             <TextBlock Text="Transform Matrix" VerticalAlignment="Center"/>
                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                 <Button Command="{x:Bind CopyBoneMatrixCommand}">
                                                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                                                         <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                                         <TextBlock Text="Copy Bone Matrix" FontSize="12"/>
                                                                     </StackPanel>
                                                                 </Button>
                                                                 <Button Command="{x:Bind PasteBoneMatrixCommand}"
                                                                         IsEnabled="{x:Bind HasCopiedMatrix, Mode=OneWay}">
                                                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                                                         <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                                                         <TextBlock Text="Paste Bone Matrix" FontSize="12"/>
                                                                     </StackPanel>
                                                                 </Button>
                                                             </StackPanel>
                                                         </Grid>

                                                         <Grid ColumnSpacing="8" RowSpacing="8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M11, Mode=TwoWay}" Grid.Row="0" Grid.Column="0" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M12, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M13, Mode=TwoWay}" Grid.Row="0" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M14, Mode=TwoWay}" Grid.Row="0" Grid.Column="3" SpinButtonPlacementMode="Compact"/>

                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M21, Mode=TwoWay}" Grid.Row="1" Grid.Column="0" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M22, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M23, Mode=TwoWay}" Grid.Row="1" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M24, Mode=TwoWay}" Grid.Row="1" Grid.Column="3" SpinButtonPlacementMode="Compact"/>

                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M31, Mode=TwoWay}" Grid.Row="2" Grid.Column="0" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M32, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M33, Mode=TwoWay}" Grid.Row="2" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M34, Mode=TwoWay}" Grid.Row="2" Grid.Column="3" SpinButtonPlacementMode="Compact"/>

                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M41, Mode=TwoWay}" Grid.Row="3" Grid.Column="0" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M42, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M43, Mode=TwoWay}" Grid.Row="3" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Value="{x:Bind SelectedBoneVm.M44, Mode=TwoWay}" Grid.Row="3" Grid.Column="3" SpinButtonPlacementMode="Compact"/>
                                                         </Grid>
                                                     </StackPanel>
                                                 </ScrollViewer>
                                            </Grid>
                                             </Expander>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                            </StackPanel>

                            <!-- Meshes Section -->
                            <StackPanel Spacing="16">
                                <TextBlock Text="Meshes" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                 <ItemsControl ItemsSource="{x:Bind ViewModel.SimpleMeshes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SimpleMeshViewModel">
                                            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="12">
                                                            <Run Text="(Material ID = "/>
                                                            <Run Text="{Binding MaterialId}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="12">
                                                    <!-- IDs -->
                                                    <TextBlock Text="IDs" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Grid ColumnSpacing="12" RowSpacing="8" ColumnDefinitions="*,*">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <NumberBox Header="Material ID" Value="{x:Bind MaterialId, Mode=TwoWay}" SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                                        <NumberBox Grid.Column="1" Header="Bone Index" Value="{x:Bind Blob.RigidBoneIndex, Mode=TwoWay}" SpinButtonPlacementMode="Inline" MinWidth="0"/>
                                                        <NumberBox Grid.Row="1" Header="Post-Ref Count"
                                                                   Value="{x:Bind PostRefCount, Mode=OneWay}"
                                                                   IsEnabled="False"
                                                                   SpinButtonPlacementMode="Inline"
                                                                   Visibility="{x:Bind IsV1_12, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                   MinWidth="0"/>
                                                    </Grid>

                                                    <!-- Transforms -->
                                                    <TextBlock Text="Transforms" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Grid ColumnSpacing="12" ColumnDefinitions="60,*">
                                                        <TextBlock Text="Scale" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                                                            <NumberBox Header="X" Value="{x:Bind ScaleX, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind ScaleY, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind ScaleZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="3" Header="W" Value="{x:Bind ScaleW, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                        </Grid>
                                                    </Grid>
                                                    <Grid ColumnSpacing="12" ColumnDefinitions="60,*">
                                                        <TextBlock Text="Position" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                                                            <NumberBox Header="X" Value="{x:Bind TransX, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind TransY, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind TransZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                            <NumberBox Grid.Column="3" Header="W" Value="{x:Bind TransW, Mode=TwoWay}" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- LOD Flags -->
                                                    <TextBlock Text="LOD Flags" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" FlowDirection="LeftToRight">
                                                        <ToggleSwitch Header="Has LODS"     IsOn="{x:Bind Blob.LOD_LODS, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 0"        IsOn="{x:Bind Blob.LOD_LOD0, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 1"        IsOn="{x:Bind Blob.LOD_LOD1, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 2"        IsOn="{x:Bind Blob.LOD_LOD2, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 3"        IsOn="{x:Bind Blob.LOD_LOD3, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 4"        IsOn="{x:Bind Blob.LOD_LOD4, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Header="LOD 5"        IsOn="{x:Bind Blob.LOD_LOD5, Mode=TwoWay}"  OnContent="" OffContent="" MinWidth="0"/>
                                                    </StackPanel>

                                                    <!-- Bucket Flags -->
                                                    <TextBlock Text="Bucket Flags" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Grid ColumnSpacing="12" RowSpacing="4" ColumnDefinitions="*,*,*">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ToggleSwitch Grid.Row="0" Grid.Column="0" Header="Opaque"            IsOn="{x:Bind IsOpaque, Mode=TwoWay}"          OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Grid.Row="0" Grid.Column="1" Header="Decal"             IsOn="{x:Bind IsDecal, Mode=TwoWay}"           OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Grid.Row="0" Grid.Column="2" Header="Transparent"       IsOn="{x:Bind IsTransparent, Mode=TwoWay}"     OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Grid.Row="1" Grid.Column="0" Header="Shadow"            IsOn="{x:Bind IsShadow, Mode=TwoWay}"          OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Not Shadow"        IsOn="{x:Bind IsNotShadow, Mode=TwoWay}"       OnContent="" OffContent="" MinWidth="0"/>
                                                        <ToggleSwitch Grid.Row="1" Grid.Column="2" Header="Alpha To Coverage" IsOn="{x:Bind IsAlphaToCoverage, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                                                    </Grid>

                                                    <!-- UV Coord Transforms -->
                                                    <TextBlock Text="UV Coord Transforms"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               Visibility="{x:Bind HasTexCoordTransforms, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                    <ItemsControl ItemsSource="{x:Bind TexCoordTransforms, Mode=OneWay}"
                                                                  Visibility="{x:Bind HasTexCoordTransforms, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TexCoordTransformViewModel">
                                                                <StackPanel Margin="0,0,0,8" Spacing="4">
                                                                    <TextBlock Text="{x:Bind Label}" Opacity="0.65" FontSize="12" FontWeight="SemiBold"/>
                                                                    <Grid ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                                                                        <NumberBox Header="X" Value="{x:Bind X, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                                        <NumberBox Grid.Column="1" Header="Y" Value="{x:Bind Y, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                                        <NumberBox Grid.Column="2" Header="Z" Value="{x:Bind Z, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                                        <NumberBox Grid.Column="3" Header="W" Value="{x:Bind W, Mode=TwoWay}" SmallChange="0.001" SpinButtonPlacementMode="Compact" MinWidth="0"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Vertex Layouts Section -->
                            <StackPanel Spacing="16">
                                <TextBlock Text="Vertex Layouts" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SimpleVertexLayouts, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VLayBlobViewModel">
                                            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                <Expander.Header>
                                                    <TextBlock Text="{x:Bind ContextName}" FontWeight="SemiBold"/>
                                                </Expander.Header>
                                                <ContentPresenter Content="{x:Bind}"
                                                                  ContentTemplate="{StaticResource VLayBlobDetailTemplate}"/>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Tree View">
                <!-- Advanced View Panel -->
                <Grid x:Name="AdvancedViewPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- ?? Tree panel ???????????????????????????????????? -->
                    <Border Grid.Column="0" 
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Tree header -->
                            <Border Grid.Row="0" Padding="14,10" 
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Bundle Structure" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <TreeView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}" 
                                      SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                                      Padding="4,4">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ObjectNode">
                                        <TreeViewItem ItemsSource="{x:Bind Children}"
                                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      MinHeight="32">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                                                <FontIcon Glyph="{x:Bind Data, Converter={StaticResource BlobIconConv}, Mode=OneWay}"
                                                          Foreground="{x:Bind Data, Converter={StaticResource BlobColorConv}, Mode=OneWay}"
                                                          FontSize="13"
                                                          VerticalAlignment="Center"
                                                          Opacity="0.9"/>
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- ?? Detail panel ?????????????????????????????????? -->
                    <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}">
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                    Visibility="{x:Bind ViewModel.SelectedNode, Mode=OneWay, Converter={StaticResource NullToVisConverter}, ConverterParameter=Invert}">
                            <FontIcon Glyph="&#xE81F;" FontSize="40"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a node to view its properties"
                                       Opacity="0.5" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ContentControl Content="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                        ContentTemplateSelector="{StaticResource BlobTemplateSelector}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Visibility="{x:Bind ViewModel.IsVLayNodeSelected, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"/>
                        <ScrollViewer Padding="20,16"
                                      Visibility="{x:Bind ViewModel.IsVLayNodeSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ContentPresenter Content="{x:Bind ViewModel.SelectedVLayWrapper, Mode=OneWay}"
                                              ContentTemplate="{StaticResource VLayBlobDetailTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
