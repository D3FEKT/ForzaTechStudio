<Page
    x:Class="ForzaTechStudio.Views.LightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:converters="using:ForzaTechStudio.Converters"
    xmlns:local="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Inverse="True"/>
        <converters:BooleanNegationConverter x:Key="BoolNeg"/>
        <local:StringToVisibilityConverter x:Key="StringToVis"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisLocal"/>
        <converters:NotNullToVisibilityConverter x:Key="NullToCollapsedConverter" Inverse="True"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisConverter"/>

        <!-- Shared card border style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Section header row style -->
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>

        <!-- Divider style -->
        <Style x:Key="HDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Property row label style -->
        <Style x:Key="PropLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Property row value style -->
        <Style x:Key="PropValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- NumberBox style for transforms -->
        <Style x:Key="TransformNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
            <Setter Property="SmallChange" Value="0.001"/>
            <Setter Property="LargeChange" Value="0.1"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <viewmodels:LightsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- progress -->
            <RowDefinition Height="*"/>      <!-- content area -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <controls:StandardPageHeader Grid.Row="0"
            Title="Lights Editor"
            Description="Parse, inspect and edit lights.bin / lightpresets.bin for Forza vehicles"
            Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button Command="{x:Bind ViewModel.OpenFileCommand}" Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <DropDownButton Style="{StaticResource GhostAccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Save lights.bin" Command="{x:Bind ViewModel.SaveLightsBinCommand}" IsEnabled="{x:Bind ViewModel.HasLightsData, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save lightpresets.bin" Command="{x:Bind ViewModel.SavePresetsBinCommand}" IsEnabled="{x:Bind ViewModel.HasPresetsData, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Save lights.bin to Zip" Command="{x:Bind ViewModel.SaveLightsToZipCommand}" IsEnabled="{x:Bind ViewModel.CanSaveLightsToZip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save lightpresets.bin to Zip" Command="{x:Bind ViewModel.SavePresetsToZipCommand}" IsEnabled="{x:Bind ViewModel.CanSavePresetsToZip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton Style="{StaticResource GhostAccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE792;" FontSize="14"/>
                                <TextBlock Text="Save As"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Save lights.bin as..." Command="{x:Bind ViewModel.SaveAsLightsBinCommand}" IsEnabled="{x:Bind ViewModel.HasLightsData, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE792;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save lightpresets.bin as..." Command="{x:Bind ViewModel.SaveAsPresetsBinCommand}" IsEnabled="{x:Bind ViewModel.HasPresetsData, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE792;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Command="{x:Bind ViewModel.ClearCommand}" Style="{StaticResource GhostAccentButtonStyle}" ToolTipService.ToolTip="Close">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.LightsFileInfo, Mode=OneWay}"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                                   Visibility="{x:Bind ViewModel.HasLightsData, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.PresetsFileInfo, Mode=OneWay}"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                                   Visibility="{x:Bind ViewModel.HasPresetsData, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Opacity="0.8"
                                   MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Progress -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,8"/>

        <!-- Content -->
        <Grid Grid.Row="2" x:Name="ContentArea" RowDefinitions="Auto,*">

            <!-- Pivot selector -->
            <SelectorBar Grid.Row="0" x:Name="TabSelector" Margin="0,0,0,8"
                         SelectionChanged="TabSelector_SelectionChanged"
                         Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <SelectorBarItem x:Name="TabLights"  Text="Lights"  IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xEA80;"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TabPresets" Text="Presets">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7DE;"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- Empty state -->
            <Grid x:Name="EmptyStatePanel"
                  Grid.Row="1"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="Page_DragOver"
                  Drop="Page_Drop"
                  Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <FontIcon Glyph="&#xEA80;" FontSize="52"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag &amp; drop zip, lights.bin or lightpresets.bin files here, or use Open"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- TAB 1 — LIGHTS -->
            <Grid x:Name="LightsTabContent" Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="8"
                  Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <!-- Left: light list -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- List header -->
                        <Border Grid.Row="0" Padding="12,10" CornerRadius="8,8,0,0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA80;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}">
                                        <Run Text="Lights"/>
                                        <Run Text=" (" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Run Text="{x:Bind ViewModel.LightCount, Mode=OneWay}"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Run Text=")" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Light list -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Lights}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLight, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  x:Name="LightsList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LightEntryViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6">
                                        <!-- Index badge -->
                                        <Border Grid.Column="0" Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Index}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <!-- Name + flags -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind FlagsDisplay, Mode=OneWay}"
                                                       FontSize="10" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- ID hex -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind IdHex, Mode=OneWay}"
                                                   FontFamily="Cascadia Code,Consolas" FontSize="10"
                                                   Opacity="0.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Add/Remove buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Padding="8"
                                    HorizontalAlignment="Stretch">
                            <Button Command="{x:Bind ViewModel.AddLightCommand}" ToolTipService.ToolTip="Add new light">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="Add" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.RemoveLightCommand}" ToolTipService.ToolTip="Remove selected light">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                    <TextBlock Text="Remove" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: property inspector for selected light -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">

                        <!-- Empty state -->
                        <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.SelectedLight, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
                            <StackPanel HorizontalAlignment="Center" Spacing="12" Padding="0,32">
                                <FontIcon Glyph="&#xEA80;" FontSize="40"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a light to inspect its properties"
                                           Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Inspector (visible when a light is selected) -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.SelectedLight, Mode=OneWay, Converter={StaticResource NotNullToVisConverter}}">

                            <!-- Identity card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Identity" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <Grid Grid.Row="2" ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="8" ColumnSpacing="12">

                                        <!-- Light ID Source selector -->
                                        <TextBlock Style="{StaticResource PropLabelStyle}" Text="ID Source"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SelectedIdSourceIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="FH3"/>
                                            <ComboBoxItem Content="FH4"/>
                                            <ComboBoxItem Content="FH5"/>
                                        </ComboBox>

                                        <!-- Light ID - FH3/FH4: editable hex text box -->
                                        <TextBlock Grid.Row="1" Style="{StaticResource PropLabelStyle}" Text="Light ID"
                                                   Visibility="{x:Bind ViewModel.IsFh3Fh4IdSource, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedLight.IdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="0x00000000"
                                                 FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                 Visibility="{x:Bind ViewModel.IsFh3Fh4IdSource, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Light ID - FH5: dropdown from hash map -->
                                        <TextBlock Grid.Row="1" Style="{StaticResource PropLabelStyle}" Text="Light ID (FH5)"
                                                   Visibility="{x:Bind ViewModel.IsFh5IdSource, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{x:Bind ViewModel.Fh5HashEntries}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedFh5Hash, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayText"
                                                  HorizontalAlignment="Stretch"
                                                  IsEditable="True"
                                                  Visibility="{x:Bind ViewModel.IsFh5IdSource, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                                        <TextBlock Grid.Row="2" Style="{StaticResource PropLabelStyle}" Text="Attachment Index"/>
                                        <NumberBox Grid.Row="2" Grid.Column="1"
                                                   Value="{x:Bind ViewModel.SelectedLight.AttachmentIndex, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Hidden"
                                                   Minimum="0"
                                                   Maximum="{x:Bind ViewModel.AttachmentCount, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch"/>

                                        <TextBlock Grid.Row="3" Style="{StaticResource PropLabelStyle}" Text="Model Path"/>
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedLight.FullModelPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="e.g. /cars/mycar/headlightl_a.modelbin"
                                                 FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                 IsReadOnly="True"
                                                 Opacity="0.6"/>

                                        <TextBlock Grid.Row="4" Style="{StaticResource PropLabelStyle}" Text="Preset Name"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedLight.PresetName, Mode=TwoWay}"
                                                 PlaceholderText="(none)" FontFamily="Cascadia Code,Consolas" FontSize="12"/>

                                        <TextBlock Grid.Row="5" Style="{StaticResource PropLabelStyle}" Text="Flags"/>
                                        <TextBox Grid.Row="5" Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedLight.FlagsHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="Cascadia Code,Consolas" FontSize="12"/>

                                        <!-- V3 GUID (version >= 3 / FM2023 only) -->
                                        <TextBlock Grid.Row="6" Style="{StaticResource PropLabelStyle}" Text="V3 GUID"
                                                   Visibility="{x:Bind ViewModel.IsVersion3, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Grid.Row="6" Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedLight.V3GuidHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="00000000-0000-0000-0000-000000000000"
                                                 FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                 Visibility="{x:Bind ViewModel.IsVersion3, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Flag toggles card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Flags" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <ItemsRepeater Grid.Row="2"
                                                  ItemsSource="{x:Bind LightFlagItems}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="260" MinColumnSpacing="8" MinRowSpacing="4"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:LightFlagItem">
                                                <CheckBox
                                                          IsChecked="{x:Bind IsSet, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind IsEnabled}">
                                                <TextBlock Text="{x:Bind Label}"
                                                          TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>
                            </Border>

                            <!-- Transform card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE946;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Transform" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">

                                        <!-- Position -->
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Style="{StaticResource PropLabelStyle}" Text="POSITION"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                <NumberBox Grid.Column="0" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.PosX, Mode=TwoWay}" Header="X"/>
                                                <NumberBox Grid.Column="1" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.PosY, Mode=TwoWay}" Header="Y"/>
                                                <NumberBox Grid.Column="2" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.PosZ, Mode=TwoWay}" Header="Z"/>
                                                <NumberBox Grid.Column="3" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.PosW, Mode=TwoWay}" Header="W"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Rotation -->
                                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Style="{StaticResource PropLabelStyle}" Text="ROTATION"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                <NumberBox Grid.Column="0" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.RotX, Mode=TwoWay}" Header="X"/>
                                                <NumberBox Grid.Column="1" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.RotY, Mode=TwoWay}" Header="Y"/>
                                                <NumberBox Grid.Column="2" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.RotZ, Mode=TwoWay}" Header="Z"/>
                                                <NumberBox Grid.Column="3" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.RotW, Mode=TwoWay}" Header="W"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Damage Position -->
                                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Style="{StaticResource PropLabelStyle}" Text="DAMAGE POSITION"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                <NumberBox Grid.Column="0" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgPosX, Mode=TwoWay}" Header="X"/>
                                                <NumberBox Grid.Column="1" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgPosY, Mode=TwoWay}" Header="Y"/>
                                                <NumberBox Grid.Column="2" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgPosZ, Mode=TwoWay}" Header="Z"/>
                                                <NumberBox Grid.Column="3" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgPosW, Mode=TwoWay}" Header="W"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Damage Rotation -->
                                        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Style="{StaticResource PropLabelStyle}" Text="DAMAGE ROTATION"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                <NumberBox Grid.Column="0" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgRotX, Mode=TwoWay}" Header="X"/>
                                                <NumberBox Grid.Column="1" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgRotY, Mode=TwoWay}" Header="Y"/>
                                                <NumberBox Grid.Column="2" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgRotZ, Mode=TwoWay}" Header="Z"/>
                                                <NumberBox Grid.Column="3" Style="{StaticResource TransformNumberBoxStyle}"
                                                           Value="{x:Bind ViewModel.SelectedLight.DmgRotW, Mode=TwoWay}" Header="W"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Attachment Index card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE81E;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Attachment Index" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <!-- Attachment column headers -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                          Padding="12,0,12,4" Margin="0,0,0,2">
                                        <Border Grid.Column="0" Width="32"/>
                                        <TextBlock Grid.Column="1" Text="Model Path" Style="{StaticResource PropLabelStyle}"/>
                                        <TextBlock Grid.Column="2" Text="Bone Index" Style="{StaticResource PropLabelStyle}" MinWidth="60" TextAlignment="Left"/>
                                    </Grid>

                                    <ListView Grid.Row="3"
                                              ItemsSource="{x:Bind ViewModel.Attachments}"
                                              SelectedItem="{x:Bind ViewModel.SelectedAttachment, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              MaxHeight="250"
                                              Margin="0,0,0,8">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:ModelEntryViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="8">
                                                    <Border Grid.Column="0" Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                            CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Index}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBox Grid.Column="1" Text="{x:Bind FullPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             FontFamily="Cascadia Code,Consolas" FontSize="11" VerticalAlignment="Center"
                                                             PlaceholderText="Model Path"/>
                                                    <NumberBox Grid.Column="2" Value="{x:Bind BoneIndex, Mode=TwoWay}"
                                                               SpinButtonPlacementMode="Hidden" MinWidth="60" VerticalAlignment="Center"
                                                               PlaceholderText="Bone"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Padding="0,8,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button Command="{x:Bind ViewModel.AddAttachmentCommand}" ToolTipService.ToolTip="Add new attachment">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Add" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.RemoveAttachmentCommand}" ToolTipService.ToolTip="Remove selected attachment">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                                <TextBlock Text="Remove" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Jump to preset button (V2 only) -->
                            <Button Command="{x:Bind ViewModel.JumpToPresetCommand}"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind ViewModel.HasPresetsData, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7DE;" FontSize="14"/>
                                    <TextBlock Text="Jump to Linked Preset"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2 — PRESETS -->
            <Grid x:Name="PresetsTabContent" Grid.Row="1" Visibility="Collapsed"
                  ColumnDefinitions="300,*" ColumnSpacing="8">

                <!-- Left: preset list -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- List header -->
                        <Border Grid.Row="0" Padding="12,10" CornerRadius="8,8,0,0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7DE;" FontSize="14"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}">
                                    <Run Text="Presets"/>
                                    <Run Text=" (" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{x:Bind ViewModel.PresetCount, Mode=OneWay}"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Run Text=")" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Preset list -->
                        <ListView Grid.Row="1" x:Name="PresetList"
                                  ItemsSource="{x:Bind ViewModel.Presets}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  CanReorderItems="True"
                                  AllowDrop="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PresetEntryViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6">
                                        <!-- Index badge -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Index}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                        <!-- Name + param count -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Opacity="0.6">
                                                <Run Text="{x:Bind ParameterCount}"/>
                                                <Run Text="params"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Hash -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind IdHex}"
                                                   FontFamily="Cascadia Code,Consolas"
                                                   FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Add/Remove buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Padding="8"
                                    HorizontalAlignment="Stretch">
                            <Button Command="{x:Bind ViewModel.AddPresetCommand}" ToolTipService.ToolTip="Add new preset">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="Add" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.RemovePresetCommand}" ToolTipService.ToolTip="Remove selected preset">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                    <TextBlock Text="Remove" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: parameter inspector for selected preset -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">

                        <!-- Empty state -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{x:Bind ViewModel.SelectedPreset, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
                            <StackPanel HorizontalAlignment="Center" Spacing="12" Padding="0,32">
                                <FontIcon Glyph="&#xE7DE;" FontSize="40"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a preset to inspect its parameters"
                                           Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Preset inspector -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.SelectedPreset, Mode=OneWay, Converter={StaticResource NotNullToVisConverter}}">

                            <!-- Identity card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Preset Identity" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <Grid Grid.Row="2" ColumnDefinitions="140,*"
                                          RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                        <TextBlock Style="{StaticResource PropLabelStyle}" Text="Hash / ID"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SelectedPreset.IdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{x:Bind ViewModel.SelectedPreset.IsV2, Mode=OneWay, Converter={StaticResource BoolNeg}}"
                                                 FontFamily="Cascadia Code,Consolas" FontSize="12" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Style="{StaticResource PropLabelStyle}" Text="Block Size"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValueStyle}"
                                                   Text="{x:Bind ViewModel.SelectedPreset.PresetSize, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="2" Style="{StaticResource PropLabelStyle}" Text="Parameters"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValueStyle}"
                                                   Text="{x:Bind ViewModel.SelectedPreset.ParameterCount, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Parameter grid card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Parameters" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>

                                    <!-- Parameter column headers -->
                                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" ColumnDefinitions="48,16,180,70,*"
                                              ColumnSpacing="8" Padding="4,0,0,6">
                                            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource PropLabelStyle}"/>
                                            <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource PropLabelStyle}"/>
                                            <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource PropLabelStyle}"/>
                                            <TextBlock Grid.Column="4" Text="Value" Style="{StaticResource PropLabelStyle}"/>
                                        </Grid>

                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{x:Bind ViewModel.SelectedPreset.Parameters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:PresetParameterViewModel">
                                                    <Grid ColumnDefinitions="48,16,180,70,*"
                                                          ColumnSpacing="8" Padding="4,3" MinHeight="36">
                                                        <!-- ID hex -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{x:Bind IdHex, Mode=OneWay}"
                                                                   FontFamily="Cascadia Code,Consolas"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <!-- Type glyph -->
                                                        <FontIcon Grid.Column="1" Glyph="{x:Bind TypeGlyph, Mode=OneWay}"
                                                                  FontSize="11" VerticalAlignment="Center"
                                                                  Opacity="0.6"/>
                                                        <!-- Name -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{x:Bind Name, Mode=OneWay}"
                                                                   ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
                                                                   FontFamily="Cascadia Code,Consolas"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- Type label -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{x:Bind TypeLabel, Mode=OneWay}"
                                                                   FontSize="10" Opacity="0.55"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Value editors — one per type, correct one made visible -->
                                                        <Grid Grid.Column="4" VerticalAlignment="Stretch">
                                                            <!-- Vec3: color swatch + picker flyout -->
                                                            <DropDownButton
                                                                    Visibility="{x:Bind IsVec3, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    Padding="2" MinWidth="0" MinHeight="0"
                                                                    VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Width="16" Height="16" CornerRadius="3">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{x:Bind Vec3Color, Mode=OneWay}"/>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}"
                                                                               FontFamily="Cascadia Code,Consolas"
                                                                               FontSize="11" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <DropDownButton.Flyout>
                                                                    <Flyout>
                                                                        <ColorPicker Color="{x:Bind Vec3Color, Mode=TwoWay}"
                                                                                     IsAlphaEnabled="False"
                                                                                     IsColorSpectrumVisible="True"
                                                                                     IsColorSliderVisible="True"
                                                                                     IsHexInputVisible="True"/>
                                                                    </Flyout>
                                                                </DropDownButton.Flyout>
                                                            </DropDownButton>
                                                            <!-- Bool: toggle switch -->
                                                            <ToggleSwitch
                                                                    Visibility="{x:Bind IsBool, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    IsOn="{x:Bind BoolValue, Mode=TwoWay}"
                                                                    OnContent="" OffContent=""
                                                                    MinWidth="0" Margin="0,-8,0,-8"
                                                                    VerticalAlignment="Center"/>
                                                            <!-- Float: number box -->
                                                            <NumberBox
                                                                    Visibility="{x:Bind IsFloat, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    Value="{x:Bind FloatValue, Mode=TwoWay}"
                                                                    SpinButtonPlacementMode="Hidden"
                                                                    SmallChange="0.001" LargeChange="0.1"
                                                                    FontFamily="Cascadia Code,Consolas"
                                                                    FontSize="11" MinWidth="120"
                                                                    VerticalAlignment="Center"/>
                                                            <!-- LightType: ComboBox -->
                                                            <ComboBox
                                                                    Visibility="{x:Bind IsLightType, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    SelectedIndex="{x:Bind LightTypeValue, Mode=TwoWay}"
                                                                    MinWidth="150"
                                                                    VerticalAlignment="Center">
                                                                <ComboBoxItem Content="None (0)"/>
                                                                <ComboBoxItem Content="Spot (1)"/>
                                                                <ComboBoxItem Content="PointAmbient (2)"/>
                                                                <ComboBoxItem Content="SpotSimple (3)"/>
                                                            </ComboBox>
                                                            <!-- UInt32: text box (supports enum-name display) -->
                                                            <TextBox
                                                                    Visibility="{x:Bind IsStandardUInt32, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    Text="{x:Bind UInt32Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                    FontFamily="Cascadia Code,Consolas"
                                                                    FontSize="11" MinWidth="120" Padding="4,2"
                                                                    VerticalAlignment="Center"/>
                                                            <!-- String: text box -->
                                                            <TextBox
                                                                    Visibility="{x:Bind IsString, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    Text="{x:Bind StringValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                    FontFamily="Cascadia Code,Consolas"
                                                                    FontSize="11" MinWidth="200" Padding="4,2"
                                                                    VerticalAlignment="Center"/>
                                                            <!-- Raw fallback: read-only -->
                                                            <TextBlock
                                                                    Visibility="{x:Bind IsRaw, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                    Text="{x:Bind DisplayValue, Mode=OneWay}"
                                                                    FontFamily="Cascadia Code,Consolas"
                                                                    FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Page>
