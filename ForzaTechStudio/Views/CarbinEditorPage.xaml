<Page
    x:Class="ForzaTechStudio.Views.CarbinEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:views="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <views:NullToBoolConverter x:Key="NullToBool"/>
        <views:StringToVisibilityConverter x:Key="StringToVisConverter"/>

        <Style x:Key="PropertyCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- New Button Style for consistent toolbar buttons -->
        <Style x:Key="SmallToolButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <MenuFlyout x:Key="ModelContextFlyout" Opening="ModelContextFlyout_Opening">
            <MenuFlyoutItem Text="Replace Model File" Click="ReplaceModelFile_Click"/>
            <MenuFlyoutItem Text="Edit Model Path" Click="EditModelPath_Click" Icon="Edit"/>
            <MenuFlyoutItem Text="Edit AO Path" Click="EditAoPath_Click" Icon="Edit"/>
        </MenuFlyout>
    </Page.Resources>

    <Page.DataContext>
        <viewmodels:CarbinEditorViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:StandardPageHeader Grid.Row="0" Title="Carbin Editor" Description="Manage car models, upgrades, and definitions" Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.NewCarbinCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.OpenCarbinCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.SaveCarbinInPlaceCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.SaveCarbinCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.ReloadFileCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" ToolTipService.ToolTip="Reload current file from disk">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Reload"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.CloseFileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.CloseAllFilesCommand}" ToolTipService.ToolTip="Close all loaded files">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Close All"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.UndoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                            <TextBlock Text="Undo"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}" Command="{x:Bind ViewModel.RedoCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14"/>
                            <TextBlock Text="Redo"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Y"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{x:Bind ViewModel.LoadedFileName, Mode=OneWay}" FontWeight="SemiBold" 
                                   Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextTrimming="CharacterEllipsis" 
                                   VerticalAlignment="Center"
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>
        
        <InfoBar Grid.Row="1" Title="Status" IsOpen="{x:Bind ViewModel.IsBusy, Mode=OneWay}" IsClosable="False" Severity="Informational" 
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Margin="0,0,0,12"/>

        <!-- Tab strip -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="AddTabBtn" Click="AddTab_Click"
                    Width="28" Height="28" Padding="0" CornerRadius="4"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="New tab">
                <FontIcon Glyph="&#xE710;" FontSize="11"/>
            </Button>
            <ListView x:Name="CarbinTabListView"
                      Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.Tabs}"
                      SelectionChanged="CarbinTabListView_SelectionChanged"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CarbinEditorTab">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       FontSize="12"
                                       ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}"/>
                            <Button Click="CloseTab_Click" Tag="{x:Bind}"
                                    Width="18" Height="18" Padding="0"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Close tab">
                                <FontIcon Glyph="&#xE711;" FontSize="9"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Empty state -->
        <Grid Grid.Row="3"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE81F;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop a .carbin file here, or use New / Open"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="3" Padding="0"
               Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <PivotItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,12,12,12" MaxWidth="1000" HorizontalAlignment="Left">
                        <StackPanel Spacing="4" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="File Metadata" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="24,0,0,0">
                                <Run Text="Scene Version: "/><Run Text="{x:Bind ViewModel.DetectedSceneVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  |  Model Version: "/><Run Text="{x:Bind ViewModel.DetectedModelVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  |  Series: "/><Run Text="{x:Bind ViewModel.IsHorizon, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="Scene Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                <ComboBox Grid.Row="0" Grid.Column="0" Header="Output Game Version"
                                          ItemsSource="{x:Bind ViewModel.GameVersions}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedVersionIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                                <NumberBox Grid.Row="0" Grid.Column="1" Header="Ordinal"
                                           Value="{x:Bind ViewModel.Ordinal, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Compact" Minimum="0"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Header="Scene Name"
                                         Text="{x:Bind ViewModel.SceneName, Mode=TwoWay}" PlaceholderText="e.g., CUSTOMCAR"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Header="Media Name"
                                         Text="{x:Bind ViewModel.MediaName, Mode=TwoWay}" PlaceholderText="e.g., CUSTOMCAR"/>
                                <TextBox Grid.Row="2" Grid.ColumnSpan="2" Header="Skeleton Path"
                                         Text="{x:Bind ViewModel.SkeletonPath, Mode=TwoWay}"
                                         PlaceholderText="game:\media\cars\CUSTOMCAR\scene\_skeleton.modelbin"/>
                                <CheckBox Grid.Row="3" Content="Build Strict Mode" IsChecked="{x:Bind ViewModel.BuildStrict, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Level of Detail (LOD)" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="LODS" IsChecked="{x:Bind ViewModel.LodFlagLODS, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD0" IsChecked="{x:Bind ViewModel.LodFlagLOD0, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD1" IsChecked="{x:Bind ViewModel.LodFlagLOD1, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD2" IsChecked="{x:Bind ViewModel.LodFlagLOD2, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD3" IsChecked="{x:Bind ViewModel.LodFlagLOD3, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD4" IsChecked="{x:Bind ViewModel.LodFlagLOD4, Mode=TwoWay}"/>
                                    <CheckBox Content="LOD5" IsChecked="{x:Bind ViewModel.LodFlagLOD5, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            
            <PivotItem Header="Standard Parts">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,0,12,0" CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Padding="12,12,12,8">
                            <TextBlock Text="Parts List" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                <Button Command="{x:Bind ViewModel.AddNonUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Part">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.RemoveNonUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Part">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ConvertToUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Convert to Upgradable Part">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.NonUpgradableParts}"
                                  SelectedItem="{x:Bind ViewModel.SelectedNonUpgradablePart, Mode=TwoWay}"
                                  Padding="0,0,0,12" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:CarbinPartEntry">
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind PartTypeName, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind Models.Count, Mode=OneWay}"/><Run Text=" Models"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer Grid.Column="1" Visibility="{x:Bind NullToVis(ViewModel.SelectedNonUpgradablePart), Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,0,12,12">

                            <!-- Standard Parts: Part Configuration -->
                            <Border Style="{StaticResource PropertyCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Part Configuration" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                        <ComboBox Header="Part Type" ItemsSource="{x:Bind ViewModel.PartTypeNames}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedNonUpgradablePart.PartTypeName, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                        <NumberBox Grid.Column="1" Header="Version" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.OriginalPartVersion, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact" Minimum="0" Maximum="65535" Width="120"/>
                                    </Grid>
                                    <Expander Header="Bounding Box" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <NumberBox Header="Min X" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMinX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="1" Header="Min Y" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMinY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="2" Header="Min Z" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMinZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <NumberBox Header="Max X" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMaxX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="1" Header="Max Y" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMaxY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="2" Header="Max Z" Value="{x:Bind ViewModel.SelectedNonUpgradablePart.BoundsMaxZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Standard Parts: Models card (with search box) -->
                            <Border Style="{StaticResource PropertyCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <TextBlock Text="Models" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Grid.Column="1" Text="Version"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Visibility="{x:Bind ViewModel.HasSelectedNonUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   Width="110"/>
                                        <TextBox Grid.Row="1" x:Name="NonUpgradableModelSearchBox"
                                                 PlaceholderText="Search models..."
                                                 TextChanged="NonUpgradableModelSearchBox_TextChanged"/>
                                        <NumberBox Grid.Row="1" Grid.Column="1"
                                                   Visibility="{x:Bind ViewModel.HasSelectedNonUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   Value="{x:Bind ViewModel.SelectedNonUpgradableModel.OriginalModelVersion, Mode=TwoWay}"
                                                   ToolTipService.ToolTip="Model Version"
                                                   SpinButtonPlacementMode="Compact" Minimum="0" Maximum="65535" Width="110"/>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                                            <Button Command="{x:Bind ViewModel.AddModelToNonUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Model">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.RemoveModelFromNonUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Model">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.DuplicateNonUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Duplicate Model">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.BrowseAoSwatchbinCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Set AO Swatchbin">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.MoveNonUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Move Model to Another Part">
                                                <FontIcon Glyph="&#xE8DE;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ListView x:Name="NonUpgradableModelsList"
                                              ItemsSource="{x:Bind ViewModel.FilteredNonUpgradableModels, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedNonUpgradableModel, Mode=TwoWay}"
                                              MinHeight="100" MaxHeight="300" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:CarbinModelEntry">
                                                <StackPanel Padding="8" ContextFlyout="{StaticResource ModelContextFlyout}" Orientation="Horizontal" Spacing="12">
                                                    <FontIcon Glyph="&#xF133;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind ModelFileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ModelGamePath, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind AoSwatchbinFileName, Mode=OneWay, Converter={StaticResource StringToVisConverter}}">
                                                            <FontIcon Glyph="&#xE91B;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Text="{x:Bind AoSwatchbinGamePath, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{x:Bind ViewModel.HasSelectedNonUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="12">

                                <!-- Material Indices � now directly below Models -->
                                <Border Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="Material Indices" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                                <Button Command="{x:Bind ViewModel.AddMaterialIndexToNonUpgradableCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Material">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.RemoveMaterialIndexFromNonUpgradableCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Material">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.LoadMaterialsForNonUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Load from Modelbin or Carbin">
                                                    <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListView ItemsSource="{x:Bind ViewModel.SelectedNonUpgradableModel.MaterialIndexes, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedNonUpgradableModel.SelectedMaterialIndex, Mode=TwoWay}"
                                                  MaxHeight="200" MinHeight="100" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:MaterialIndexEntry">
                                                    <Grid Padding="4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1" Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Material Name"
                                                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                            <NumberBox Value="{x:Bind ValueAsDouble, Mode=TwoWay}"
                                                                       Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"
                                                                       SpinButtonPlacementMode="Compact" Width="100"/>
                                                            <TextBox Text="{x:Bind ValueHexString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                     Width="170" PlaceholderText="0x0000000000000000"/>
                                                            <ComboBox ItemsSource="{x:Bind SavedMaterialHashes, Mode=OneWay}"
                                                                      SelectedItem="{x:Bind SelectedSavedMaterialHash, Mode=TwoWay}"
                                                                      Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                      Width="190" PlaceholderText="Saved hash"
                                                                      ToolTipService.ToolTip="Choose saved material hash">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="viewmodels:SavedMaterialHash">
                                                                        <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <!-- Transform & Bone -->
                                <Border Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Transform &amp; Bone" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Grid ColumnDefinitions="2*, 1*, Auto" ColumnSpacing="12">
                                            <TextBox Header="Bone Name" Text="{x:Bind ViewModel.SelectedNonUpgradableModel.BoneName, Mode=TwoWay}"/>
                                            <NumberBox Grid.Column="1" Header="Bone ID" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.BoneId, Mode=TwoWay}" Minimum="-1" SpinButtonPlacementMode="Compact"/>
                                            <CheckBox Grid.Column="2" Content="Snap to Parent" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.SnapToParent, Mode=TwoWay}" Margin="0,26,0,0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                            <NumberBox Header="Pos X" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.PositionX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Column="1" Header="Pos Y" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.PositionY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Column="2" Header="Pos Z" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.PositionZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            <NumberBox Grid.Column="3" Header="Scale" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.Scale, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Drop Part Data" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <CheckBox Content="Is Droppable" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsDroppable, Mode=TwoWay}"/>
                                        <Expander Header="Drop Settings" HorizontalAlignment="Stretch"
                                                  IsExpanded="{x:Bind ViewModel.SelectedNonUpgradableModel.IsDroppable, Mode=OneWay}">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                                <NumberBox Header="Drop Value" Value="{x:Bind ViewModel.SelectedNonUpgradableModel.DropValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <TextBox Grid.Column="1" Header="Drop Part ID" Text="{x:Bind ViewModel.SelectedNonUpgradableModel.DropPartIdHexString, Mode=TwoWay}"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Draw Flags" HorizontalAlignment="Stretch" IsExpanded="True">
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="140">
                                        <CheckBox Content="Exterior" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupExterior, Mode=TwoWay}"/>
                                        <CheckBox Content="Cockpit" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupCockpit, Mode=TwoWay}"/>
                                        <CheckBox Content="Shadow" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupShadow, Mode=TwoWay}"/>
                                        <CheckBox Content="Hood" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupHood, Mode=TwoWay}"/>
                                        <CheckBox Content="Reflection" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupWindshieldReflection, Mode=TwoWay}"/>
                                        <CheckBox Content="No Driver" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupDriverlessCockpit, Mode=TwoWay}"/>
                                        <CheckBox Content="Proxy" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.DrawGroupProxyLOD, Mode=TwoWay}"/>
                                    </VariableSizedWrapGrid>
                                </Expander>

                                <Expander Header="Advanced Render Parameters" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Surface Interactions" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="120">
                                            <CheckBox Content="Int Windshield" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsInteriorWindshield, Mode=TwoWay}"/>
                                            <CheckBox Content="Impact Mask" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesImpactMask, Mode=TwoWay}"/>
                                            <CheckBox Content="Splatter" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesSplatterMask, Mode=TwoWay}"/>
                                            <CheckBox Content="Damage" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesDamage, Mode=TwoWay}"/>
                                            <CheckBox Content="Dirt" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesDirt, Mode=TwoWay}"/>
                                            <CheckBox Content="Oil" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesOil, Mode=TwoWay}"/>
                                            <CheckBox Content="Rubber" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesRubber, Mode=TwoWay}"/>
                                            <CheckBox Content="Rain" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.ReceivesRain, Mode=TwoWay}"/>
                                        </VariableSizedWrapGrid>

                                        <TextBlock Text="Game Specific (FM23)" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="120">
                                            <CheckBox Content="Interior" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsInterior, Mode=TwoWay}"/>
                                            <CheckBox Content="Left Window" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsLeftSideWindow, Mode=TwoWay}"/>
                                            <CheckBox Content="Right Window" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsRightSideWindow, Mode=TwoWay}"/>
                                            <CheckBox Content="Nascar Wiper" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsNascarWiper, Mode=TwoWay}"/>
                                            <CheckBox Content="License Plate" IsChecked="{x:Bind ViewModel.SelectedNonUpgradableModel.IsLicensePlate, Mode=TwoWay}"/>
                                        </VariableSizedWrapGrid>
                                    </StackPanel>
                                </Expander>

                                <Border Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="GUIDs &amp; Assembly" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Header="GUID" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedNonUpgradableModel.GuidV13, Mode=OneWay}"/>
                                        <TextBox Header="Drop GUID" IsReadOnly="True" Text="{x:Bind ViewModel.SelectedNonUpgradableModel.DropGuidV14, Mode=OneWay}"/>
                                        <TextBox Header="Assembly Name" Text="{x:Bind ViewModel.SelectedNonUpgradableModel.AssemblyName, Mode=TwoWay}" PlaceholderText="Optional assembly reference"/>
                                        <NumberBox Header="Horizon ID"
                                                   Value="{x:Bind ViewModel.SelectedNonUpgradableModel.HorizonId, Mode=TwoWay}"
                                                   ToolTipService.ToolTip="Used by Horizon model versions 17 and newer"
                                                   SpinButtonPlacementMode="Compact" Minimum="0" Maximum="255"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PropertyCardStyle}"
                                    Visibility="{x:Bind ViewModel.ShouldShowSelectedNonUpgradableDetailsSwatchbin, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="FH6 Details" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBox Header="Details swatchbin"
                                                 Text="{x:Bind ViewModel.SelectedNonUpgradableModel.HorizonUnkV21Path, Mode=TwoWay}"
                                                 PlaceholderText="game:\media\...\details.swatchbin"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Upgrades">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,0,12,0" CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>

                            <Grid Padding="12,12,12,8">
                                <TextBlock Text="Upgrade Parts" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                    <Button Command="{x:Bind ViewModel.AddUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Part">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.RemoveUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Part">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.ConvertToNonUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Convert to Standard Part">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.UpgradableParts}"
                                      SelectedItem="{x:Bind ViewModel.SelectedUpgradablePart, Mode=TwoWay}"
                                      Padding="0,0,0,12" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:CarbinPartEntry">
                                        <Grid Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind PartTypeName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind Upgrades.Count, Mode=OneWay}"/><Run Text=" Upgrades | "/>
                                                    <Run Text="{x:Bind Models.Count, Mode=OneWay}"/><Run Text=" Models"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Grid.Row="2" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Height="1" Margin="12,4"/>

                            <Grid Grid.Row="3" Visibility="{x:Bind NullToVis(ViewModel.SelectedUpgradablePart), Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Padding="12,8">
                                    <TextBlock Text="Upgrade Levels" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <Button Command="{x:Bind ViewModel.AddUpgradeCommand}" Padding="8,0" FontSize="10" Content="+"/>
                                        <Button Command="{x:Bind ViewModel.RemoveUpgradeCommand}" Padding="8,0" FontSize="10" Content="-"/>
                                    </StackPanel>
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedUpgradablePart.Upgrades, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedUpgrade, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:UpgradeEntry">
                                            <Grid Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="13">
                                                        <Run Text="Level "/><Run Text="{x:Bind Level, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="ID: "/><Run Text="{x:Bind Id, Mode=OneWay}"/>
                                                        <Run Text=" | Body: "/><Run Text="{x:Bind CarBodyId, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                        <ScrollViewer Grid.Column="1" Visibility="{x:Bind NullToVis(ViewModel.SelectedUpgradablePart), Mode=OneWay}">
                            <StackPanel Spacing="12" Padding="0,0,12,12">

                                <!-- Upgrade Configuration -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSelectedUpgrade, Mode=OneWay}">
                                    <Border Style="{StaticResource PropertyCardStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <!-- Left: fields -->
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Upgrade Configuration" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <!-- 4 evenly-sized NumberBoxes in one row -->
                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                                    <NumberBox Header="Level" Value="{x:Bind ViewModel.SelectedUpgrade.Level, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="0" Maximum="255"/>
                                                    <NumberBox Grid.Column="1" Header="ID" Value="{x:Bind ViewModel.SelectedUpgrade.Id, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                    <NumberBox Grid.Column="2" Header="Body ID" Value="{x:Bind ViewModel.SelectedUpgrade.CarBodyId, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                    <NumberBox Grid.Column="3" Header="Version" Value="{x:Bind ViewModel.SelectedUpgrade.Version, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="4"/>
                                                </Grid>
                                                <!-- Checkboxes + Part Type -->
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                                    <CheckBox Content="Is Stock" IsChecked="{x:Bind ViewModel.SelectedUpgrade.IsStock, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="1" Content="Parent Is Stock" IsChecked="{x:Bind ViewModel.SelectedUpgrade.ParentIsStock, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="2" Header="Part Type" ItemsSource="{x:Bind ViewModel.PartTypeNames}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedUpgradablePart.PartTypeName, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"/>
                                                </Grid>
                                                <!-- Upgrade Bounding Box -->
                                                <Expander Header="Upgrade Bounding Box" HorizontalAlignment="Stretch">
                                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                            <NumberBox Header="Min X" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMinX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Grid.Column="1" Header="Min Y" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMinY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Grid.Column="2" Header="Min Z" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMinZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                            <NumberBox Header="Max X" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMaxX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Grid.Column="1" Header="Max Y" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMaxY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                            <NumberBox Grid.Column="2" Header="Max Z" Value="{x:Bind ViewModel.SelectedUpgrade.BoundsMaxZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                            <!-- Right: Shared Model Upgrade IDs -->
                                            <Border Grid.Column="1" MinWidth="240" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <Grid>
                                                        <TextBlock Text="Upgrade IDs" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                                            <Button Command="{x:Bind ViewModel.AddUpgradeIdToModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Upgrade ID">
                                                                <FontIcon Glyph="&#xE710;" FontSize="11"/>
                                                            </Button>
                                                            <Button Command="{x:Bind ViewModel.RemoveUpgradeIdFromModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Selected">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                                            </Button>
                                                            <Button Command="{x:Bind ViewModel.AddUpgradeIdToAllModelsCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add ID to All Models">
                                                                <FontIcon Glyph="&#xECCD;" FontSize="11"/>
                                                            </Button>
                                                            <Button Command="{x:Bind ViewModel.RemoveUpgradeIdFromAllModelsCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove ID from All Models">
                                                                <FontIcon Glyph="&#xE894;" FontSize="11"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ListView ItemsSource="{x:Bind ViewModel.SelectedUpgradableModel.UpgradeIdWrappers, Mode=OneWay}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedUpgradableModel.SelectedUpgradeIdWrapper, Mode=TwoWay}"
                                                              MaxHeight="200" MinHeight="60"
                                                              BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4"
                                                              SelectionMode="Single">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="viewmodels:UpgradeIdWrapper">
                                                                <NumberBox Value="{x:Bind ValueAsDouble, Mode=TwoWay}"
                                                                           SpinButtonPlacementMode="Compact"
                                                                           Minimum="-2147483648" Maximum="2147483647"
                                                                           Margin="4,2"/>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Models card with search -->
                                <Border Style="{StaticResource PropertyCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                            <TextBlock Text="Models" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Grid.Column="1" Text="Version"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Visibility="{x:Bind ViewModel.HasSelectedUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                       Width="110"/>
                                            <TextBox Grid.Row="1" x:Name="UpgradableModelSearchBox"
                                                     PlaceholderText="Search models..."
                                                     TextChanged="UpgradableModelSearchBox_TextChanged"/>
                                            <NumberBox Grid.Row="1" Grid.Column="1"
                                                       Visibility="{x:Bind ViewModel.HasSelectedUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                       Value="{x:Bind ViewModel.SelectedUpgradableModel.OriginalModelVersion, Mode=TwoWay}"
                                                       ToolTipService.ToolTip="Model Version"
                                                       SpinButtonPlacementMode="Compact" Minimum="0" Maximum="65535" Width="110"/>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                                                <Button Command="{x:Bind ViewModel.AddModelToUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Model">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.RemoveModelFromUpgradablePartCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Model">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.DuplicateUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Duplicate Model">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.BrowseAoSwatchbinForUpgradableCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Set AO Swatchbin">
                                                    <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                                </Button>
                                                <Button Command="{x:Bind ViewModel.MoveUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Move Model to Another Part">
                                                    <FontIcon Glyph="&#xE8DE;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="UpgradableModelsList"
                                                  ItemsSource="{x:Bind ViewModel.FilteredUpgradableModels, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedUpgradableModel, Mode=TwoWay}"
                                                  MinHeight="100" MaxHeight="300" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:CarbinModelEntry">
                                                    <StackPanel Padding="8" ContextFlyout="{StaticResource ModelContextFlyout}" Orientation="Horizontal" Spacing="12">
                                                        <FontIcon Glyph="&#xF133;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{x:Bind ModelFileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{x:Bind ModelGamePath, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind AoSwatchbinFileName, Mode=OneWay, Converter={StaticResource StringToVisConverter}}">
                                                                <FontIcon Glyph="&#xE91B;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                <TextBlock Text="{x:Bind AoSwatchbinGamePath, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{x:Bind ViewModel.HasSelectedUpgradableModel, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="12">

                                    <!-- Material Indices -->
                                    <Border Style="{StaticResource PropertyCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <TextBlock Text="Material Indices" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                                    <Button Command="{x:Bind ViewModel.AddMaterialIndexToUpgradableCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Add Material">
                                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.RemoveMaterialIndexFromUpgradableCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Remove Material">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.LoadMaterialsForUpgradableModelCommand}" Style="{StaticResource SmallToolButtonStyle}" ToolTipService.ToolTip="Load from Modelbin or Carbin">
                                                        <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <ListView ItemsSource="{x:Bind ViewModel.SelectedUpgradableModel.MaterialIndexes, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ViewModel.SelectedUpgradableModel.SelectedMaterialIndex, Mode=TwoWay}"
                                                      MaxHeight="200" MinHeight="100" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:MaterialIndexEntry">
                                                        <Grid Padding="4,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBox Grid.Column="1" Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Material Name"
                                                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                                <NumberBox Value="{x:Bind ValueAsDouble, Mode=TwoWay}"
                                                                           Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"
                                                                           SpinButtonPlacementMode="Compact" Width="100"/>
                                                                <TextBox Text="{x:Bind ValueHexString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                         Width="170" PlaceholderText="0x0000000000000000"/>
                                                                <ComboBox ItemsSource="{x:Bind SavedMaterialHashes, Mode=OneWay}"
                                                                          SelectedItem="{x:Bind SelectedSavedMaterialHash, Mode=TwoWay}"
                                                                          Visibility="{x:Bind UseHexValue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                          Width="190" PlaceholderText="Saved hash"
                                                                          ToolTipService.ToolTip="Choose saved material hash">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="viewmodels:SavedMaterialHash">
                                                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>

                                    <!-- Transform & Bone -->
                                    <Border Style="{StaticResource PropertyCardStyle}">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Transform &amp; Bone" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <Grid ColumnDefinitions="2*, 1*, Auto" ColumnSpacing="12">
                                                <TextBox Header="Bone Name" Text="{x:Bind ViewModel.SelectedUpgradableModel.BoneName, Mode=TwoWay}"/>
                                                <NumberBox Grid.Column="1" Header="Bone ID" Value="{x:Bind ViewModel.SelectedUpgradableModel.BoneId, Mode=TwoWay}" Minimum="-1" SpinButtonPlacementMode="Compact"/>
                                                <CheckBox Grid.Column="2" Content="Snap to Parent" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.SnapToParent, Mode=TwoWay}" Margin="0,26,0,0"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                                <NumberBox Header="Pos X" Value="{x:Bind ViewModel.SelectedUpgradableModel.PositionX, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="1" Header="Pos Y" Value="{x:Bind ViewModel.SelectedUpgradableModel.PositionY, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="2" Header="Pos Z" Value="{x:Bind ViewModel.SelectedUpgradableModel.PositionZ, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                <NumberBox Grid.Column="3" Header="Scale" Value="{x:Bind ViewModel.SelectedUpgradableModel.Scale, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Drop Part Data -->
                                    <Border Style="{StaticResource PropertyCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Drop Part Data" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <CheckBox Content="Is Droppable" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsDroppable, Mode=TwoWay}"/>
                                            <Expander Header="Drop Settings" HorizontalAlignment="Stretch"
                                                      IsExpanded="{x:Bind ViewModel.SelectedUpgradableModel.IsDroppable, Mode=OneWay}">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                                    <NumberBox Header="Drop Value" Value="{x:Bind ViewModel.SelectedUpgradableModel.DropValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                                    <TextBox Grid.Column="1" Header="Drop Part ID (hex)" Text="{x:Bind ViewModel.SelectedUpgradableModel.DropPartIdHexString, Mode=TwoWay}"/>
                                                </Grid>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Draw Flags" HorizontalAlignment="Stretch" IsExpanded="True">
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="140">
                                            <CheckBox Content="Exterior" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupExterior, Mode=TwoWay}"/>
                                            <CheckBox Content="Cockpit" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupCockpit, Mode=TwoWay}"/>
                                            <CheckBox Content="Shadow" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupShadow, Mode=TwoWay}"/>
                                            <CheckBox Content="Hood" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupHood, Mode=TwoWay}"/>
                                            <CheckBox Content="Reflection" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupWindshieldReflection, Mode=TwoWay}"/>
                                            <CheckBox Content="No Driver" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupDriverlessCockpit, Mode=TwoWay}"/>
                                            <CheckBox Content="Proxy" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.DrawGroupProxyLOD, Mode=TwoWay}"/>
                                        </VariableSizedWrapGrid>
                                    </Expander>

                                    <Expander Header="Advanced Render Parameters" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Surface Interactions" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="120">
                                                <CheckBox Content="Int Windshield" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsInteriorWindshield, Mode=TwoWay}"/>
                                                <CheckBox Content="Impact Mask" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesImpactMask, Mode=TwoWay}"/>
                                                <CheckBox Content="Splatter" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesSplatterMask, Mode=TwoWay}"/>
                                                <CheckBox Content="Damage" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesDamage, Mode=TwoWay}"/>
                                                <CheckBox Content="Dirt" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesDirt, Mode=TwoWay}"/>
                                                <CheckBox Content="Oil" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesOil, Mode=TwoWay}"/>
                                                <CheckBox Content="Rubber" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesRubber, Mode=TwoWay}"/>
                                                <CheckBox Content="Rain" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.ReceivesRain, Mode=TwoWay}"/>
                                            </VariableSizedWrapGrid>

                                            <TextBlock Text="Game Specific (FM23)" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="120">
                                                <CheckBox Content="Interior" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsInterior, Mode=TwoWay}"/>
                                                <CheckBox Content="Left Window" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsLeftSideWindow, Mode=TwoWay}"/>
                                                <CheckBox Content="Right Window" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsRightSideWindow, Mode=TwoWay}"/>
                                                <CheckBox Content="Nascar Wiper" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsNascarWiper, Mode=TwoWay}"/>
                                                <CheckBox Content="License Plate" IsChecked="{x:Bind ViewModel.SelectedUpgradableModel.IsLicensePlate, Mode=TwoWay}"/>
                                            </VariableSizedWrapGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- GUIDs & Assembly -->
                                    <Border Style="{StaticResource PropertyCardStyle}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="GUIDs &amp; Assembly" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBox Grid.Row="0" Grid.ColumnSpan="2" Header="GUID" IsReadOnly="True"
                                                         Text="{x:Bind ViewModel.SelectedUpgradableModel.GuidV13, Mode=OneWay}"/>
                                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Drop GUID" IsReadOnly="True"
                                                         Text="{x:Bind ViewModel.SelectedUpgradableModel.DropGuidV14, Mode=OneWay}"/>
                                            </Grid>
                                            <TextBox Header="Assembly Name" Text="{x:Bind ViewModel.SelectedUpgradableModel.AssemblyName, Mode=TwoWay}" PlaceholderText="Optional assembly reference"/>
                                                                                        <NumberBox Header="Horizon ID"
                                                                                                             Value="{x:Bind ViewModel.SelectedUpgradableModel.HorizonId, Mode=TwoWay}"
                                                                                                             ToolTipService.ToolTip="Used by Horizon model versions 17 and newer"
                                                                                                             SpinButtonPlacementMode="Compact" Minimum="0" Maximum="255"/>
                                        </StackPanel>
                                    </Border>

                                        <Border Style="{StaticResource PropertyCardStyle}"
                                            Visibility="{x:Bind ViewModel.ShouldShowSelectedUpgradableDetailsSwatchbin, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="FH6 Details" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBox Header="Details swatchbin"
                                                     Text="{x:Bind ViewModel.SelectedUpgradableModel.HorizonUnkV21Path, Mode=TwoWay}"
                                                     PlaceholderText="game:\media\...\details.swatchbin"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </PivotItem>

        </Pivot>
    </Grid>
</Page>
