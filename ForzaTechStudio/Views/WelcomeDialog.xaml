<ContentDialog
    x:Class="ForzaTechStudio.Views.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForzaTechStudio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    DefaultButton="Primary"
    PrimaryButtonText="Set Up Game Paths"
    SecondaryButtonText="Skip for now">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">800</x:Double>
    </ContentDialog.Resources>

    <Grid Margin="-24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left pane: Branding -->
        <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="8,0,0,8" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Assets/store_logo.PNG" Width="140" Height="140" Margin="0,0,0,24" />
                <TextBlock Text="ForzaTech" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Studio" FontSize="26" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                <TextBlock Text="Multi Forza asset tools" FontSize="14" Foreground="#DDFFFFFF" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- Right pane: Features & Options -->
        <Grid Grid.Column="1" Padding="40" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Version badge + title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="v0.9.1.0" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <TextBlock Text="What's New" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Opacity="0.75" FontStyle="Italic"
                       Text="Thanks for the support — let's all make some cool mods together."/>

            <!-- Changelog entries -->
            <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Top">

                <!-- Entry -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemAccentColorLight2}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" Opacity="0.85"
                               Text="Initial pre-release — many bugs may still be present."/>
                </Grid>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemAccentColorLight2}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" Opacity="0.85"
                               Text="Check out the Forza Mods Discord for support and suggestions."/>
                </Grid>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemAccentColorLight2}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <HyperlinkButton x:Name="ChangelogButton" Grid.Column="1" Padding="0"
                                     Content="Version change logs"
                                     FontSize="14"
                                     Click="ChangelogButton_Click"/>
                </Grid>

            </StackPanel>

            <!-- Bottom actions -->
            <StackPanel Grid.Row="3" Spacing="12">
                <HyperlinkButton Content="Join the community Discord" NavigateUri="https://discord.gg/forzamods" Padding="0"/>
                <CheckBox x:Name="DontShowAgainCheckBox" Content="Don't show this again" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>