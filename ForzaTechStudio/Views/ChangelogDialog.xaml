<ContentDialog
    x:Class="ForzaTechStudio.Views.ChangelogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Title="Version Change Logs"
    CloseButtonText="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">520</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" MinWidth="480">
        <Grid Margin="0,8,0,8">
            <controls:MarkdownTextBlock
                x:Name="MdBlock"
                Background="Transparent"
                Padding="0"
                IsTextSelectionEnabled="True"
                WrapCodeBlock="True"
                HorizontalAlignment="Stretch"/>
        </Grid>
    </ScrollViewer>
</ContentDialog>
