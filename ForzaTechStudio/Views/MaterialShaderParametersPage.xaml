<Page
    x:Class="ForzaTechStudio.Views.MaterialShaderParametersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Back Button -->
                <Button Grid.Column="0" Command="{x:Bind ViewModel.GoBackCommand}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Material Shader Parameters" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.MaterialName, Mode=OneWay}" 
                               Style="{StaticResource SubtitleTextBlockStyle}" 
                               Opacity="0.6"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ViewKnownParametersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="List"/>
                            <TextBlock Text="Reference"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ImportParametersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Import"/>
                            <TextBlock Text="Import"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.AddParameterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add"/>
                            <TextBlock Text="Add Parameter"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar Severity="Informational" IsOpen="True" 
                     Title="Shader Parameters" 
                     Message="Edit shader parameters below. Changes are applied directly to the material. Remember to save the parent file to persist changes." />
        </StackPanel>

        <!-- Parameters Editor -->
        <ScrollViewer Grid.Row="1" Margin="0,24,0,0">
            <controls:MaterialParameterEditorView 
                ParametersSource="{x:Bind ViewModel.Parameters, Mode=OneWay}" 
                RemoveParameterCommand="{x:Bind ViewModel.RemoveParameterCommand}"/>
        </ScrollViewer>
    </Grid>
</Page>
