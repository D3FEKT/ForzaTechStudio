<Page
    x:Class="ForzaTechStudio.Views.ManufacturerColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:converters="using:ForzaTechStudio.Converters"
    x:Name="Root"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Inverse="True"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header with Commands -->
        <controls:StandardPageHeader Grid.Row="0" 
                                     Title="Manufacturer Colors" 
                                     Description="Edit ManufacturerColors.bin files"
                                     Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.NewFileCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenFileCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SaveFileCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>
                    
                    <Button Command="{x:Bind ViewModel.AddGroupCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add Group"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Command="{x:Bind ViewModel.CloseFileCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" 
                               VerticalAlignment="Center" 
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Empty state -->
        <Grid Grid.Row="1"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsFileLoaded, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE790;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop a ManufacturerColors.bin here, or use New / Open"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1"
              Visibility="{x:Bind ViewModel.IsFileLoaded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tree/List of Groups and Entries -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="File Structure" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                    
                    <TreeView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Groups}"
                              SelectionMode="Single"
                              SelectionChanged="TreeView_SelectionChanged">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ManufacturerColorNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="{x:Bind Icon, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"/>
                                        
                                        <!-- Show Add/Remove buttons for Groups only -->
                                        <StackPanel Orientation="Horizontal" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                            <Button Style="{StaticResource GhostAccentButtonStyle}"
                                                    Command="{x:Bind Owner.AddEntryCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="Add Materialbin"
                                                    Padding="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="10"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostAccentButtonStyle}"
                                                    Command="{x:Bind Owner.RemoveGroupCommand, Mode=OneWay}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="Remove Group"
                                                    Padding="4">
                                                <FontIcon Glyph="&#xE74D;" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- Show Remove button for Entries only -->
                                        <Button Style="{StaticResource GhostAccentButtonStyle}"
                                                Visibility="{x:Bind EntryVisibility, Mode=OneWay}"
                                                Command="{x:Bind Owner.RemoveEntryCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind}"
                                                ToolTipService.ToolTip="Remove Entry"
                                                Padding="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Detail Editor -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <!-- Detail Pane (Visible when Entry is selected) -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.IsEntrySelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left" DataContext="{x:Bind ViewModel.SelectedEntry, Mode=OneWay}">
                            <TextBlock Text="Entry Details" Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="MaterialBin Path" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="game:\media\..."/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Material Index Mask" FontWeight="SemiBold"/>
                                <NumberBox Value="{Binding MaterialIndexMask, Mode=TwoWay}"
                                           SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline"/>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                            <StackPanel Spacing="12">
                                <TextBlock Text="Preview Color" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Visual Preview -->
                                    <StackPanel Spacing="12">
                                        <Border Width="120" Height="120" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding UiColor, Mode=OneWay}"/>
                                            </Border.Background>
                                        </Border>
                                        
                                        <TextBlock Text="RGB (0-255)" HorizontalAlignment="Center" Opacity="0.7" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Numeric Control -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <ColorPicker Color="{Binding UiColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False" IsColorSliderVisible="True"/>
                                        
                                        <TextBlock Text="Raw Values (0.0 - 1.0)" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="R" Opacity="0.7"/>
                                                <NumberBox Value="{Binding PreviewColorX, Mode=TwoWay}" SmallChange="0.01"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="G" Opacity="0.7"/>
                                                <NumberBox Value="{Binding PreviewColorY, Mode=TwoWay}" SmallChange="0.01"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="B" Opacity="0.7"/>
                                                <NumberBox Value="{Binding PreviewColorZ, Mode=TwoWay}" SmallChange="0.01"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                                Visibility="{x:Bind ViewModel.IsEntrySelected, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}">
                        <FontIcon Glyph="&#xE91B;" FontSize="64" Opacity="0.2"/>
                        <TextBlock Text="Select an entry to edit its properties" Opacity="0.5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
