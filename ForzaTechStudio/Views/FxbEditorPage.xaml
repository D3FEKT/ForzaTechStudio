<Page
    x:Class="ForzaTechStudio.Views.FxbEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:views="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>

        <Style x:Key="PropLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity"          Value="0.65"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HDividerStyle" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <Style x:Key="VecNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
            <Setter Property="SmallChange"             Value="0.001"/>
            <Setter Property="LargeChange"             Value="0.1"/>
            <Setter Property="MinWidth"                Value="72"/>
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- - Standard page header - -->
        <controls:StandardPageHeader Grid.Row="0"
            Title="FxStudio Bank Viewer"
            Description="Inspect and edit FxStudio particle bank (.fxb) effects, phases, components and properties"
            Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenFxbCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveAsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.CloseFileCommand}"
                            IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.LoadedFileName, Mode=OneWay}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    </StackPanel>

                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- - Busy indicator - -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,8"/>

        <!-- - Empty state - -->
        <Grid Grid.Row="2"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE945;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop an .fxb file here, or use Open"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- - Master-Detail layout - -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="420"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- - Left: effect tree - -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="12,12,12,8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.Bank.BankName, Mode=OneWay}"/>
                        <Run Text=" - "/><Run Text="{x:Bind ViewModel.Bank.NumberEffects, Mode=OneWay}"/>
                        <Run Text=" effects"/>
                    </TextBlock>
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="v"/><Run Text="{x:Bind ViewModel.Bank.Version, Mode=OneWay}"/>
                        <Run Text="  /  "/><Run Text="{x:Bind ViewModel.Bank.BankSize, Mode=OneWay}"/>
                        <Run Text=" bytes"/>
                    </TextBlock>
                </StackPanel>

                <TreeView x:Name="EffectTree"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Bank.Effects, Mode=OneWay}"
                          SelectionMode="Single"
                          CanDragItems="False" CanReorderItems="False"
                          ItemInvoked="EffectTree_ItemInvoked"
                          Padding="0,0,0,8">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:FxbEffectNode">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,2">
                                <FontIcon Glyph="&#xE945;" FontSize="13"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="ID=0x"/><Run Text="{x:Bind NId, Mode=OneWay}"/>
                                        <Run Text="  "/><Run Text="{x:Bind FDuration, Mode=OneWay}"/><Run Text="s"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Splitter -->
            <Border Grid.Column="1"
                    Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Margin="0,8"/>

            <!-- - Right: detail pane - -->
            <ScrollViewer Grid.Column="2"
                          Padding="12,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0">

                    <!-- - No-selection placeholder - -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center"
                                Margin="0,60"
                                Visibility="{x:Bind NullToVis(ViewModel.SelectedNode), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8A4;" FontSize="40"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an effect in the tree to begin."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- -
                         EFFECT DETAIL
                         - -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.IsEffectSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <!-- Effect header card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <FontIcon Glyph="&#xE945;" FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Effect" Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="10">
                                    <TextBox Header="Name"
                                             Text="{x:Bind ViewModel.SelectedEffect.Name, Mode=OneWay}"
                                             IsReadOnly="True"/>
                                    <NumberBox Grid.Column="1" Header="Numeric ID"
                                               Value="{x:Bind ViewModel.SelectedEffect.NId, Mode=OneWay}"
                                               IsEnabled="False"/>
                                    <NumberBox Grid.Row="1" Header="Duration (s)"
                                               Value="{x:Bind ViewModel.SelectedEffect.FDuration, Mode=TwoWay}"
                                               SmallChange="0.01" SpinButtonPlacementMode="Compact"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Header="LOD Category offset"
                                             Text="{x:Bind ViewModel.SelectedEffect.LodCategory, Mode=OneWay}"
                                             IsReadOnly="True"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Phases card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Phases" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <ListView x:Name="PhasesList"
                                          ItemsSource="{x:Bind ViewModel.SelectedEffect.Phases, Mode=OneWay}"
                                          SelectionChanged="PhasesList_SelectionChanged"
                                          MaxHeight="200" MinHeight="36"
                                          SelectionMode="Single"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbPhaseNode">
                                            <Grid ColumnDefinitions="*,80,60" ColumnSpacing="12" Padding="4,3">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind FDuration, Mode=OneWay}"/><Run Text="s"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="x"/><Run Text="{x:Bind PlayCountDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Components card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Components" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <ListView x:Name="ComponentsList"
                                          ItemsSource="{x:Bind ViewModel.SelectedEffect.Components, Mode=OneWay}"
                                          SelectionChanged="ComponentsList_SelectionChanged"
                                          MaxHeight="260" MinHeight="36"
                                          SelectionMode="Single"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbComponentNode">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="4,3">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind TimeRange, Mode=OneWay}"
                                                               FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind NumPropertyValues, Mode=OneWay}"/>
                                                    <Run Text=" prop"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- -
                         PHASE DETAIL
                         - -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.IsPhaseSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <FontIcon Glyph="&#xE102;" FontSize="15"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    <TextBlock Text="Phase" Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="10">
                                    <TextBox Grid.ColumnSpan="2" Header="Phase Name"
                                             Text="{x:Bind ViewModel.SelectedPhase.Name, Mode=OneWay}"
                                             IsReadOnly="True"/>
                                    <NumberBox Grid.Row="1" Header="Duration (s)"
                                               Value="{x:Bind ViewModel.SelectedPhase.FDuration, Mode=TwoWay}"
                                               SmallChange="0.01" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Row="1" Grid.Column="1" Header="Play Count (-1 = 8)"
                                               Value="{x:Bind ViewModel.SelectedPhase.NPlayCount, Mode=TwoWay}"
                                               Minimum="-1" SmallChange="1"
                                               SpinButtonPlacementMode="Compact"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- -
                         COMPONENT DETAIL
                         - -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.IsComponentSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <!-- Component header -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <FontIcon Glyph="&#xE713;" FontSize="15"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="Component" Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="10">
                                    <TextBox Grid.ColumnSpan="2" Header="Type"
                                             Text="{x:Bind ViewModel.SelectedComponent.TypeName, Mode=OneWay}"
                                             IsReadOnly="True"/>
                                    <NumberBox Grid.Row="1" Header="Start Time (s)"
                                               Value="{x:Bind ViewModel.SelectedComponent.FStartTime, Mode=TwoWay}"
                                               SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Row="1" Grid.Column="1" Header="End Time (s)"
                                               Value="{x:Bind ViewModel.SelectedComponent.FEndTime, Mode=TwoWay}"
                                               SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Property values list -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Property Values" Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <ListView x:Name="PropertiesList"
                                          ItemsSource="{x:Bind ViewModel.SelectedComponent.PropertyValues, Mode=OneWay}"
                                          SelectionChanged="PropertiesList_SelectionChanged"
                                          MaxHeight="340" MinHeight="36"
                                          SelectionMode="Single"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbPropertyValueNode">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="4,4">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{x:Bind TypeId, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Summary, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- -
                         PROPERTY DETAIL � rich per-type editor
                         - -->
                    <StackPanel Spacing="0"
                                Visibility="{x:Bind ViewModel.IsPropertySelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <!-- Back to component button -->
                        <Button Margin="0,0,0,8"
                                Style="{StaticResource GhostAccentButtonStyle}"
                                Click="PropertyBackButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                                <TextBlock Text="Back to Component"/>
                            </StackPanel>
                        </Button>

                        <!-- Property identity + semantic hint -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedProperty.DisplayName, Mode=OneWay}"
                                               Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}"/>
                                <Grid Grid.Row="2" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="8">
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Type"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind ViewModel.SelectedProperty.TypeId, Mode=OneWay}"
                                               FontFamily="Cascadia Code, Consolas" FontSize="12"/>

                                    <TextBlock Grid.Row="1" Style="{StaticResource PropLabelStyle}"
                                               Text="Description"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind ViewModel.SelectedProperty.SemanticHint, Mode=OneWay}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- - FloatRange editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsFloatRange, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Float Range"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <NumberBox Header="Minimum"
                                               Value="{x:Bind ViewModel.SelectedProperty.FloatMin, Mode=TwoWay}"
                                               SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Column="1" Header="Maximum"
                                               Value="{x:Bind ViewModel.SelectedProperty.FloatMax, Mode=TwoWay}"
                                               SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- - IntegerRange editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsIntegerRange, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Integer Range"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <NumberBox Header="Minimum"
                                               Value="{x:Bind ViewModel.SelectedProperty.IntMin, Mode=TwoWay}"
                                               SmallChange="1" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Column="1" Header="Maximum"
                                               Value="{x:Bind ViewModel.SelectedProperty.IntMax, Mode=TwoWay}"
                                               SmallChange="1" SpinButtonPlacementMode="Compact"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- - Integer inline editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsIntegerInline, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Integer (inline)"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <NumberBox Grid.Row="2" Header="Value"
                                           Value="{x:Bind ViewModel.SelectedProperty.IntValue, Mode=TwoWay}"
                                           SmallChange="1" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                        </Border>

                        <!-- - Float inline editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsFloatInline, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Float (inline)"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <NumberBox Grid.Row="2" Header="Value"
                                           Value="{x:Bind ViewModel.SelectedProperty.FloatValue, Mode=TwoWay}"
                                           SmallChange="0.001" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                        </Border>

                        <!-- - String property (read-only) - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsStringProperty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="String"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <TextBox Grid.Row="2" Header="Value"
                                         Text="{x:Bind ViewModel.SelectedProperty.StringValue, Mode=OneWay}"
                                         IsReadOnly="True"/>
                            </Grid>
                        </Border>

                        <!-- - Vector3 editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsVector3, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Vector3"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <NumberBox Style="{StaticResource VecNumberBoxStyle}" Header="X"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecX, Mode=TwoWay}"/>
                                    <NumberBox Grid.Column="1" Style="{StaticResource VecNumberBoxStyle}" Header="Y"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecY, Mode=TwoWay}"/>
                                    <NumberBox Grid.Column="2" Style="{StaticResource VecNumberBoxStyle}" Header="Z"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecZ, Mode=TwoWay}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- - Vector4 editor - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsVector4, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="Vector4"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <NumberBox Style="{StaticResource VecNumberBoxStyle}" Header="X"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecX, Mode=TwoWay}"/>
                                    <NumberBox Grid.Column="1" Style="{StaticResource VecNumberBoxStyle}" Header="Y"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecY, Mode=TwoWay}"/>
                                    <NumberBox Grid.Column="2" Style="{StaticResource VecNumberBoxStyle}" Header="Z"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecZ, Mode=TwoWay}"/>
                                    <NumberBox Grid.Column="3" Style="{StaticResource VecNumberBoxStyle}" Header="W"
                                               Value="{x:Bind ViewModel.SelectedProperty.VecW, Mode=TwoWay}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- - Linear float keyframes - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropHasLinearKeyframes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Linear Float Keyframes"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Padding="4,0">
                                    <TextBlock Text="Unit Time" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource PropLabelStyle}"/>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedProperty.LinearKeyframes, Mode=OneWay}"
                                          MaxHeight="320" SelectionMode="None"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbLinearKeyframeRow">
                                            <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Padding="0,2">
                                                <NumberBox Value="{x:Bind UnitTime, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Hidden"
                                                           HorizontalAlignment="Stretch"/>
                                                <NumberBox Grid.Column="1" Value="{x:Bind Value, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Hidden"
                                                           HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- - Cubic float keyframes - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropHasCubicKeyframes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Cubic Float Keyframes"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid ColumnDefinitions="80,*,*,*,*" ColumnSpacing="8" Padding="4,0">
                                    <TextBlock Text="End Time" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="A" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="2" Text="B" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="3" Text="C" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="4" Text="D" Style="{StaticResource PropLabelStyle}"/>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedProperty.CubicKeyframes, Mode=OneWay}"
                                          MaxHeight="320" SelectionMode="None"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbCubicKeyframeRow">
                                            <Grid ColumnDefinitions="80,*,*,*,*" ColumnSpacing="8" Padding="0,2">
                                                <NumberBox Value="{x:Bind EndUnitTime, Mode=TwoWay}"
                                                           SmallChange="0.001" SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="1" Value="{x:Bind A, Mode=TwoWay}"
                                                           SmallChange="0.0001" SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="2" Value="{x:Bind B, Mode=TwoWay}"
                                                           SmallChange="0.0001" SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="3" Value="{x:Bind C, Mode=TwoWay}"
                                                           SmallChange="0.0001" SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="4" Value="{x:Bind D, Mode=TwoWay}"
                                                           SmallChange="0.0001" SpinButtonPlacementMode="Hidden"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- - Color ARGB keyframes - -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.PropIsColorKeyframe, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Color Keyframes (ARGB)"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Border Style="{StaticResource HDividerStyle}" Margin="0"/>
                                <Grid ColumnDefinitions="80,50,50,50,50" ColumnSpacing="8" Padding="4,0">
                                    <TextBlock Text="Time"  Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="A" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="2" Text="R" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="3" Text="G" Style="{StaticResource PropLabelStyle}"/>
                                    <TextBlock Grid.Column="4" Text="B" Style="{StaticResource PropLabelStyle}"/>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedProperty.ColorKeyframes, Mode=OneWay}"
                                          MaxHeight="320" SelectionMode="None"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                          CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FxbColorKeyframeRow">
                                            <Grid ColumnDefinitions="80,50,50,50,50" ColumnSpacing="8" Padding="0,2">
                                                <NumberBox Value="{x:Bind UnitTime, Mode=TwoWay}"
                                                           SmallChange="0.01" SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="1" Value="{x:Bind Alpha, Mode=TwoWay}"
                                                           Minimum="0" Maximum="255" SmallChange="1"
                                                           SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="2" Value="{x:Bind Red, Mode=TwoWay}"
                                                           Minimum="0" Maximum="255" SmallChange="1"
                                                           SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="3" Value="{x:Bind Green, Mode=TwoWay}"
                                                           Minimum="0" Maximum="255" SmallChange="1"
                                                           SpinButtonPlacementMode="Hidden"/>
                                                <NumberBox Grid.Column="4" Value="{x:Bind Blue, Mode=TwoWay}"
                                                           Minimum="0" Maximum="255" SmallChange="1"
                                                           SpinButtonPlacementMode="Hidden"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel><!-- /property detail -->

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
