<Page
    x:Class="ForzaTechStudio.Views.SwatchbinEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header with Commands -->
        <controls:StandardPageHeader Grid.Row="0" 
                                     Title="Swatchbin Tool" 
                                     Description="View and create .swatchbin textures, and inspect .pb texture bundles. Supports Xbox and PC formats."
                                     Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenFileButton" Click="OpenFileButton_Click" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open File"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="CreateButton" Click="CreateButton_Click"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Create Swatchbin"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>
                    
                    <Button x:Name="ReplaceButton" Click="ReplaceButton_Click" 
                            IsEnabled="False"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                            <TextBlock Text="Replace Texture"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveAsButton" 
                            IsEnabled="False"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="SaveAsDdsMenuItem" 
                                                Text="Save as DDS" 
                                                Click="SaveAsDds_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="SaveAsPcSwatchbinMenuItem" 
                                                Text="Save as PC Swatchbin" 
                                                Click="SaveAsPcSwatchbin_Click"
                                                IsEnabled="False">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AB;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="SaveAsPngMenuItem"
                                                Text="Save as PNG"
                                                Click="SaveAsPng_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="SaveAsJpgMenuItem"
                                                Text="Save as JPG"
                                                Click="SaveAsJpg_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save As"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>
                    
                    <Button x:Name="CloseFileButton" Click="CloseFileButton_Click"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- - Empty state - -->
            <Grid x:Name="EmptyStatePanel"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="Page_DragOver"
                  Drop="Page_Drop"
                  Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <FontIcon Glyph="&#xE790;" FontSize="52"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag &amp; drop a .swatchbin, .pb, .zip, or .minizip file here, or use Open File"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- File Info Panel -->
            <Border x:Name="InfoColumnBorder"
                    Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,16,0"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InfoPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Texture Information" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                        
                        <!-- File Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="File Name" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="FileNameText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Swatchbin Selector (visible when multiple files loaded) -->
                        <StackPanel x:Name="FileSelectionPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Loaded Textures" FontWeight="SemiBold" Opacity="0.7"/>
                            <ComboBox x:Name="SwatchbinSelector" 
                                      HorizontalAlignment="Stretch"
                                      MaxDropDownHeight="400"
                                      SelectionChanged="SwatchbinSelector_SelectionChanged"
                                      PlaceholderText="Select a texture..."/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Platform Info -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Platform" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="PlatformText" Text="PC"/>
                        </StackPanel>

                        <!-- Xbox-specific Info (only visible for Durango) -->
                        <StackPanel x:Name="XboxInfoPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Tile Mode" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="TileModeText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Dimensions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Width" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="WidthText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Height" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="HeightText"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Depth" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="DepthText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Mip Levels" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="MipLevelsText"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Format -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DXGI Format" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="FormatText" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Encoding" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="EncodingText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Transcoding" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="TranscodingText"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Color Profile" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="ColorProfileText"/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Flags -->
                        <TextBlock Text="Flags" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4"/>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemHeight="60">
                            <CheckBox x:Name="IsCubeCheck" Content="Cube Map" IsEnabled="False" Margin="0,0,12,0"/>
                            <CheckBox x:Name="IsPremultCheck" Content="Premultiplied Alpha" IsEnabled="False" Margin="0,0,12,0"/>
                            <CheckBox x:Name="Is3DCheck" Content="3D Texture" IsEnabled="False"/>
                        </VariableSizedWrapGrid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Version Info -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Bundle Version" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="BundleVersionText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Blob Version" FontWeight="SemiBold" Opacity="0.7"/>
                                <TextBlock x:Name="BlobVersionText"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Texture GUID" FontWeight="SemiBold" Opacity="0.7"/>
                            <TextBlock x:Name="GuidText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Texture Preview -->
            <Border x:Name="PreviewColumnBorder"
                    Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource LayerFillColorAltBrush}" 
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                          BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                            <Button x:Name="ZoomOutButton" Content="-" Width="32" Click="ZoomOutButton_Click"/>
                            <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="10" StepFrequency="0.1" Value="1" 
                                    Width="120" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                            <Button x:Name="ZoomInButton" Content="+" Width="32" Click="ZoomInButton_Click"/>
                            <TextBlock x:Name="ZoomPercentText" Text="100%" VerticalAlignment="Center" 
                                       Margin="8,0,0,0" Width="45" TextAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Fit" Click="FitZoomButton_Click" ToolTipService.ToolTip="Fit to Window" 
                                    FontSize="12"/>
                            <Button Content="1:1" Click="ActualSizeButton_Click" ToolTipService.ToolTip="Actual Size" 
                                    FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Content -->
                    <Grid Grid.Row="1">
                        <!-- Placeholder -->
                        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <FontIcon Glyph="&#xE91B;" FontSize="64" Opacity="0.3"/>
                            <TextBlock Text="No texture loaded" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open a .swatchbin, .pb, .zip, or .minizip file to preview" Opacity="0.3" HorizontalAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <!-- Texture Display -->
                        <ScrollViewer x:Name="TextureScrollViewer" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Auto"
                                      ZoomMode="Enabled"
                                      MinZoomFactor="0.1"
                                      MaxZoomFactor="10"
                                      Visibility="Collapsed"
                                      ViewChanged="TextureScrollViewer_ViewChanged">
                            <Grid x:Name="ImageContainer" 
                                  Background="#1A1A1A"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  PointerPressed="ImageContainer_PointerPressed"
                                  PointerMoved="ImageContainer_PointerMoved"
                                  PointerReleased="ImageContainer_PointerReleased"
                                  PointerCanceled="ImageContainer_PointerReleased"
                                  PointerExited="ImageContainer_PointerReleased">
                                <!-- Checkerboard pattern for transparency -->
                                <Image x:Name="TextureImage"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- Loading indicator -->
                        <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
