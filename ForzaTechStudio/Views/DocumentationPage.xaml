<Page
    x:Class="ForzaTechStudio.Views.DocumentationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- ?? Sidebar nav item style  -->
        <Style x:Key="DocNavItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ?? Section header style  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="14,16,0,4"/>
            <Setter Property="CharacterSpacing" Value="80"/>
        </Style>

        <!-- ?? Entry DataTemplate ?? -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid Padding="10,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="{Binding Glyph}"
                          FontSize="16"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- ?? Section header DataTemplate ?? -->
        <DataTemplate x:Key="SectionTemplate">
            <TextBlock Text="{Binding Label}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Opacity="0.5"
                       Margin="12,14,0,2"
                       CharacterSpacing="80"
                       IsHitTestVisible="False"/>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="260"/>
            <!-- Divider -->
            <ColumnDefinition Width="1"/>
            <!-- Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR  -->
        <Grid Grid.Column="0"
              Background="{ThemeResource NavigationViewExpandedPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar header -->
            <Border Grid.Row="0" Padding="16,20,16,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE736;" FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Documentation"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="ForzaTech Studio"
                               FontSize="12"
                               Opacity="0.5"
                               Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Nav list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,4,8,16">
                <StackPanel>

                    <ListView x:Name="NavList"
                              SelectionMode="Single"
                              SelectionChanged="NavList_SelectionChanged"
                              ContainerContentChanging="NavList_ContainerContentChanging"
                              ItemContainerStyle="{StaticResource DocNavItemStyle}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Vertical divider -->
        <Border Grid.Column="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Content header / breadcrumb bar -->
            <Border Grid.Row="0"
                    Padding="32,16,32,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="ForzaTech Studio"
                                   FontSize="13"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Opacity="0.4" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BreadcrumbTitle"
                                   Text="Select a topic"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="GithubButton"
                            Click="GithubButton_Click"
                            Style="{StaticResource DefaultButtonStyle}"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                            <TextBlock Text="View on GitHub" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Placeholder shown when nothing selected -->
            <StackPanel x:Name="PlaceholderPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <FontIcon Glyph="&#xE736;"
                          FontSize="56"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Select a topic from the sidebar"
                           FontSize="15"
                           Opacity="0.45"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Markdown content area -->
            <ScrollViewer x:Name="ContentScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Padding="0,0,0,0">
                <Grid MaxWidth="860" HorizontalAlignment="Left" Margin="40,32,40,48">
                    <controls:MarkdownTextBlock
                        x:Name="MdBlock"
                        Background="Transparent"
                        Padding="0"
                        IsTextSelectionEnabled="True"
                        WrapCodeBlock="True"
                        LinkClicked="MdBlock_LinkClicked"
                        HorizontalAlignment="Stretch"/>
                </Grid>
            </ScrollViewer>

            <!-- Loading spinner overlay -->
            <Grid x:Name="LoadingOverlay"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ProgressRing IsActive="True" Width="36" Height="36"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

    </Grid>
</Page>
