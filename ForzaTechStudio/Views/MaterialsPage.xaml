<Page
    x:Class="ForzaTechStudio.Views.MaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ForzaTechStudio.ViewModels"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d">


    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header with Commands -->
        <controls:StandardPageHeader Grid.Row="0" 
                                     Title="Material Library" 
                                     Description="Manage and extract existing material blobs from Modelbins"
                                     Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ExtractMaterialsCommand}" 
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14"/>
                            <TextBlock Text="Extract Materials from Files"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshMaterialsCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh Library"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="R"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenMaterialsFolderCommand}"
                            Style="{StaticResource GhostAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="Open Directory"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>
                    
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12"/>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="16,12,16,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Saved Materials" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedLibraryFileName, Mode=OneWay}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   FontFamily="Cascadia Code, Consolas"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Header="Game Library"
                              ItemsSource="{x:Bind ViewModel.AvailableGames}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="GameId"
                              SelectedValue="{x:Bind ViewModel.SelectedGameId, Mode=TwoWay}"
                              MinWidth="280"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <ListView Grid.Row="1" Margin="16,12,16,16" ItemsSource="{x:Bind ViewModel.Materials, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MaterialDisplayItem">
                            <Grid Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xF56E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Margin="0,0,16,0" FontSize="16"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind DataSize}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>