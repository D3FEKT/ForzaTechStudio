<Page
    x:Class="ForzaTechStudio.Views.ViewportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ForzaTechStudio.ViewModels.ThreeDViewer"
    xmlns:converters="using:ForzaTechStudio.Converters"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    DragLeave="Page_DragLeave"
    Drop="Page_Drop">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="SelectAllVisibleMeshes_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:NodeTypeIconConverter x:Key="NodeTypeIconConverter"/>
        <converters:BoolToVisibilityIconConverter x:Key="BoolToVisibilityIconConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Used by the Materials filter dialog for virtualized rendering -->
        <DataTemplate x:Key="MaterialFilterItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      Content="{Binding MaterialName}"
                      HorizontalAlignment="Stretch"/>
        </DataTemplate>

        <!-- Used by the Objects filter dialog for virtualized rendering -->
        <DataTemplate x:Key="ObjectFilterItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TypeLabel}"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               FontSize="11"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="380" MinWidth="0"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel (collapsible content) -->
        <Border x:Name="LeftPanelContent"
                Grid.Row="1"
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- Tab Strip -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ListView x:Name="TabListView"
                                      ItemsSource="{x:Bind ViewModel.Tabs}"
                                      SelectionMode="Single"
                                      SelectionChanged="TabListView_SelectionChanged"
                                      Height="32">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="80" MaxWidth="120" Padding="8,0,4,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,4,0"/>
                                            <Button Grid.Column="1"
                                                    Click="CloseTab_Click"
                                                    Tag="{Binding}"
                                                    Padding="2"
                                                    MinWidth="16"
                                                    MinHeight="16"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE711;" FontSize="7"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                        <Button x:Name="AddTabBtn"
                                Grid.Column="1"
                                Click="AddTab_Click"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="New Tab">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tree View -->
                <TreeView x:Name="FileTree"
                          Grid.Row="1"
                          SelectionMode="Multiple"
                          ItemInvoked="FileTree_ItemInvoked"
                          SelectionChanged="FileTree_SelectionChanged"
                          RightTapped="FileTree_RightTapped"
                          Padding="0,0,0,8">
                     <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,2" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <CheckBox IsChecked="{Binding Content.IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="False"
                                          MinWidth="20"
                                          MinHeight="20"
                                          Margin="0,-4,0,-4"
                                          VerticalAlignment="Center"/>

                                <FontIcon Grid.Column="1" 
                                          Glyph="{Binding Content.Type, Converter={StaticResource NodeTypeIconConverter}}"
                                          FontSize="14"
                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" 
                                           Text="{Binding Content.Name}" 
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                     </TreeView.ItemTemplate>
                </TreeView>

                <!-- Properties Area (Bottom Left) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="450" Padding="0,0,0,8">
                    <StackPanel Spacing="2">
                        <!-- Transform Controls Section -->
                        <Expander x:Name="ModelPropertiesExpander"
                                  Header="Model Properties"
                                  IsExpanded="True"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="12,8"
                                  Margin="8,0,8,0">
                            <StackPanel Spacing="8">
                                 <Grid ColumnSpacing="8">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="*" />
                                     </Grid.ColumnDefinitions>
                                     
                                     <ComboBox x:Name="ModelBinSelector" 
                                               Header="Model" 
                                               HorizontalAlignment="Stretch" 
                                               SelectionChanged="ModelBinSelector_SelectionChanged" 
                                               Grid.Column="0"
                                               FontSize="12" MinHeight="28">
                                         <ComboBox.ItemTemplate>
                                             <DataTemplate>
                                                 <Grid ColumnSpacing="4">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12">
                                                         <Run Text="{Binding Name}"/>
                                                         <Run Text="{Binding BoneStatusText}" Foreground="Orange" FontSize="10"/>
                                                     </TextBlock>
                                                     <Button Grid.Column="1" Margin="4,0,0,0" Padding="2" Background="Transparent" BorderThickness="0" Click="ModelBinVisibility_Click" MinHeight="20" MinWidth="20">
                                                         <FontIcon Glyph="{Binding IsChecked, Converter={StaticResource BoolToVisibilityIconConverter}}" FontSize="10"/>
                                                     </Button>
                                                 </Grid>
                                             </DataTemplate>
                                         </ComboBox.ItemTemplate>
                                     </ComboBox>
                                               
                                     <ComboBox x:Name="MeshSelector" 
                                               Header="Target Scope" 
                                               HorizontalAlignment="Stretch" 
                                               SelectionChanged="MeshSelector_SelectionChanged" 
                                               Grid.Column="1"
                                               FontSize="12" MinHeight="28">
                                         <ComboBox.ItemTemplate>
                                             <DataTemplate>
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                     <Button Grid.Column="1" Margin="4,0,0,0" Padding="2" Background="Transparent" BorderThickness="0" Click="MeshVisibility_Click" MinHeight="20" MinWidth="20">
                                                         <FontIcon Glyph="{Binding IsChecked, Converter={StaticResource BoolToVisibilityIconConverter}}" FontSize="10"/>
                                                     </Button>
                                                 </Grid>
                                             </DataTemplate>
                                         </ComboBox.ItemTemplate>
                                     </ComboBox>
                                 </Grid>

                                <TextBlock x:Name="MultiSelectText"
                                           Text=""
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="Collapsed"
                                           Margin="0,0,0,0"/>

                                <TextBlock x:Name="ConflictingTransformsText" 
                                           Text="Conflicting transform values" 
                                           Foreground="Red" 
                                           FontSize="11" 
                                           HorizontalAlignment="Center" 
                                           Visibility="Collapsed"
                                           Margin="0,-4,0,0"/>

                                <!-- Position Controls -->
                                <StackPanel Spacing="4">
                                     <TextBlock Text="Position" FontWeight="SemiBold" FontSize="12"/>
                                     <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Trans X -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="X" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TransX" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="TransX_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="TransX_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Trans Y -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Y" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TransY" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="TransY_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="TransY_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Trans Z -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Z" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TransZ" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="TransZ_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="TransZ_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>

                                <!-- Scale Controls -->
                                <StackPanel x:Name="ScaleControlsPanel" Spacing="4">
                                    <TextBlock Text="Scale" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Scale X -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="X" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ScaleX" Text="1.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="ScaleX_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="ScaleX_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Scale Y -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Y" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ScaleY" Text="1.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="ScaleY_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="ScaleY_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Scale Z -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Z" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ScaleZ" Text="1.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="ScaleZ_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="ScaleZ_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Rotation Controls (Euler Angles) -->
                                <StackPanel x:Name="RotationControlsPanel" Spacing="4">
                                    <TextBlock Text="Rotation (Degrees)" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Rot X -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="X" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RotX" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="RotX_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="RotX_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Rot Y -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Y" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RotY" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="RotY_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="RotY_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Rot Z -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Z" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Grid ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="RotZ" Text="0.000" TextChanged="Transform_TextChanged" FontSize="11" MinHeight="24" Padding="4,2"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <RepeatButton Click="RotZ_Up" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="8"/>
                                                    </RepeatButton>
                                                    <RepeatButton Click="RotZ_Down" Height="12" Width="16" Padding="0" CornerRadius="2">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                 <!-- Reset Button -->
                                 <Button Content="Reset Transformations" 
                                         HorizontalAlignment="Stretch" 
                                         Click="ResetTransform_Click"
                                         Style="{StaticResource AccentButtonStyle}"
                                         FontSize="12" MinHeight="28"/>

                                <!-- Bone Section -->
                                <Expander x:Name="BoneInfoExpander"
                                          Header="Bone"
                                          IsExpanded="True"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Padding="8,6"
                                          Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <!-- Bone name + Change button -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BoneNameText"
                                                       Text="(no bone)"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <Button x:Name="ChangeBoneButton"
                                                    Grid.Column="1"
                                                    Content="Change"
                                                    Click="ChangeBone_Click"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    MinHeight="24"
                                                    ToolTipService.ToolTip="Pick a different bone from the skeleton"/>
                                        </Grid>

                                        <!-- Use Bone Transforms toggle -->
                                        <CheckBox x:Name="UseBoneTransformsToggle"
                                                  Content="Use Bone Transforms"
                                                  IsChecked="True"
                                                  FontSize="11"
                                                  Click="UseBoneTransforms_Click"/>

                                        <!-- Bone matrix label -->
                                        <TextBlock Text="Bone Matrix (local)"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>

                                        <!-- Row 1 -->
                                        <StackPanel Spacing="2">
                                            <Grid ColumnSpacing="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="_11" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="_12" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="_13" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="_14" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <Grid ColumnSpacing="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BM11" PlaceholderText="_11" TextChanged="BoneMatrix_TextChanged" FontSize="10" MinHeight="22" Padding="3,1"/><StackPanel Grid.Column="1" Spacing="1"><RepeatButton Click="BM11_Up" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70E;" FontSize="8"/></RepeatButton><RepeatButton Click="BM11_Down" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70D;" FontSize="8"/></RepeatButton></StackPanel></Grid>
                                                <Grid Grid.Column="1" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BM12" PlaceholderText="_12" TextChanged="BoneMatrix_TextChanged" FontSize="10" MinHeight="22" Padding="3,1"/><StackPanel Grid.Column="1" Spacing="1"><RepeatButton Click="BM12_Up" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70E;" FontSize="8"/></RepeatButton><RepeatButton Click="BM12_Down" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70D;" FontSize="8"/></RepeatButton></StackPanel></Grid>
                                                <Grid Grid.Column="2" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BM13" PlaceholderText="_13" TextChanged="BoneMatrix_TextChanged" FontSize="10" MinHeight="22" Padding="3,1"/><StackPanel Grid.Column="1" Spacing="1"><RepeatButton Click="BM13_Up" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70E;" FontSize="8"/></RepeatButton><RepeatButton Click="BM13_Down" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70D;" FontSize="8"/></RepeatButton></StackPanel></Grid>
                                                <Grid Grid.Column="3" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BM14" PlaceholderText="_14" TextChanged="BoneMatrix_TextChanged" FontSize="10" MinHeight="22" Padding="3,1"/><StackPanel Grid.Column="1" Spacing="1"><RepeatButton Click="BM14_Up" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70E;" FontSize="8"/></RepeatButton><RepeatButton Click="BM14_Down" Height="12" Width="16" Padding="0" CornerRadius="2"><FontIcon Glyph="&#xE70D;" FontSize="8"/></RepeatButton></StackPanel></Grid>
                                            </Grid>
                                        </StackPanel>

