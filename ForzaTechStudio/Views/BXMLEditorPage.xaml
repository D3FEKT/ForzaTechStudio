<Page
    x:Class="ForzaTechStudio.Views.BXMLEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:views="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <views:BoolToVisibilityConverter    x:Key="BoolToVis"/>
        <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <views:NullToVisibilityConverter    x:Key="NullToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>

        <Style x:Key="HDividerStyle" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Standard page header -->
        <controls:StandardPageHeader Grid.Row="0"
            Title="BXML Editor"
            Description="Open, inspect, edit and convert Forza Binary XML (.xml, .bxml) files to and from plain XML"
            Margin="0,0,0,12">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenBxmlCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveAsBxmlCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save as BXML (.xml)"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveAsXmlCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save as XML"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.CloseFileCommand}"
                            IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,8"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.LoadedFileName, Mode=OneWay}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <!-- Busy indicator -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,8"/>

        <!-- Empty state -->
        <Grid Grid.Row="2"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE8D5;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; drop a .bxml or .xml file here, or use Open"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Content: Pivot -->
        <Pivot Grid.Row="2" Padding="0"
               Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">

            <!-- TAB 1 — Tree View -->
            <PivotItem Header="Tree View">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="160" MaxWidth="400"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: node tree -->
                    <Grid Grid.Column="0"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Padding="12,10,12,6" Spacing="2">
                            <TextBlock Text="Node Tree" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Click a node to inspect or edit"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TreeView x:Name="BXMLTree"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  CanDragItems="False" CanReorderItems="False"
                                  ItemInvoked="BXMLTree_ItemInvoked"
                                  Padding="0,0,0,8">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="1" Padding="0,3">
                                        <TextBlock Text="{Binding Content.Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Content.SubtextInfo}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <!-- Splitter -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            Margin="0,8"/>

                    <!-- Right: node detail -->
                    <ScrollViewer Grid.Column="2"
                                  Padding="12,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0">

                            <!-- No-selection placeholder -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center"
                                        Margin="0,60"
                                        Visibility="{x:Bind ViewModel.IsNodeNotSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="&#xE8A4;" FontSize="40"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a node in the tree to inspect and edit."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Node detail panel -->
                            <StackPanel Spacing="0"
                                        Visibility="{x:Bind ViewModel.IsNodeSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                                <!-- Node name card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D5;" FontSize="15"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Element" Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource HDividerStyle}"/>
                                        <TextBox Header="Element Name"
                                                 Text="{x:Bind ViewModel.SelectedNode.Name, Mode=TwoWay}"
                                                 PlaceholderText="Element name"/>
                                    </StackPanel>
                                </Border>

                                <!-- Attributes card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE946;" FontSize="15"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="Attributes" Style="{StaticResource SectionHeaderStyle}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{x:Bind ViewModel.AddAttributeCommand}"
                                                    Style="{StaticResource GhostAccentButtonStyle}"
                                                    Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                    <TextBlock Text="Add" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Style="{StaticResource HDividerStyle}"/>

                                        <!-- Empty attributes placeholder -->
                                        <TextBlock Text="No attributes on this element."
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind ViewModel.IsNodeSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   x:Name="NoAttrsPlaceholder"/>

                                        <!-- Attribute rows -->
                                        <ItemsControl x:Name="AttributesList"
                                                      ItemsSource="{x:Bind ViewModel.SelectedNode.Attributes, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:BXMLAttributeViewModel">
                                                    <Grid ColumnDefinitions="*,12,*,Auto"
                                                          Margin="0,0,0,6">
                                                        <TextBox Grid.Column="0"
                                                                 Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Name"
                                                                 FontSize="13"/>
                                                        <TextBlock Grid.Column="1" Text="="
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBox Grid.Column="2"
                                                                 Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Value"
                                                                 FontSize="13"/>
                                                        <Button Grid.Column="3"
                                                                Margin="6,0,0,0"
                                                                Click="RemoveAttribute_Click"
                                                                Tag="{x:Bind}"
                                                                Padding="8,6"
                                                                ToolTipService.ToolTip="Remove attribute">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Children info card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF168;" FontSize="15"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Children" Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource HDividerStyle}"/>
                                        <TextBlock x:Name="ChildrenInfoText"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sync to XML button -->
                                <Button Command="{x:Bind ViewModel.SyncTreeToXmlCommand}"
                                        Style="{StaticResource GhostAccentButtonStyle}"
                                        Margin="0,4,0,12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14"/>
                                        <TextBlock Text="Sync tree edits to XML Source tab"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </PivotItem>

            <!-- TAB 2 — XML Source -->
            <PivotItem Header="XML Source">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostAccentButtonStyle}"
                                Command="{x:Bind ViewModel.ApplyXmlChangesCommand}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                                <TextBlock Text="Apply Changes"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Edit XML below, then click Apply Changes to refresh the tree."
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Opacity="0.8"/>
                    </StackPanel>

                    <!-- XML text editor -->
                    <Border Grid.Row="1"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBox x:Name="XmlTextBox"
                                 Text="{x:Bind ViewModel.XmlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="13"
                                 IsSpellCheckEnabled="False"
                                 BorderThickness="0"
                                 CornerRadius="6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
