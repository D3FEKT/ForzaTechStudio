<Page
    x:Class="ForzaTechStudio.Views.BXMLEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ForzaTechStudio.ViewModels"
    xmlns:views="using:ForzaTechStudio.Views"
    xmlns:controls="using:ForzaTechStudio.Views.Controls"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>

        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PaneTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"/>

        <Style x:Key="SmallMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="PillBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:StandardPageHeader Grid.Row="0"
            Title="BXML Editor"
            Description="Browse, edit, search, and convert Forza Binary XML files"
            Margin="0,0,0,4">
            <controls:StandardPageHeader.HeaderCommands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenBxmlCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenZipCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xED25;" FontSize="14"/>
                            <TextBlock Text="Open ZIP"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,7"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveAsBxmlCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save BXML"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveAsXmlCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save XML"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,7"
                            Visibility="{x:Bind ViewModel.IsObjectModelMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveObjectModelZipCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsObjectModelMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Rebuild the archive in place with all edited object models">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save to ZIP"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveObjectModelZipAsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsObjectModelMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Write a new archive copy with all edited object models">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE792;" FontSize="14"/>
                            <TextBlock Text="Save ZIP As"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,7"/>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                            <TextBlock Text="Clear Filters"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                            Command="{x:Bind ViewModel.CloseFileCommand}"
                            IsEnabled="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W"/>
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,7"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.LoadedFileName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SmallMetaTextStyle}"
                                   VerticalAlignment="Center"
                                   MaxWidth="520"/>
                    </StackPanel>
                </StackPanel>
            </controls:StandardPageHeader.HeaderCommands>
        </controls:StandardPageHeader>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="2"
                Style="{StaticResource PaneBorderStyle}"
                Padding="10"
                Visibility="{x:Bind ViewModel.IsZipMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xED25;" FontSize="15"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.LoadedZipName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.FilteredZipEntryCountText, Mode=OneWay}"
                                   Style="{StaticResource SmallMetaTextStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Column="2"
                             PlaceholderText="Search ZIP entries"
                             Text="{x:Bind ViewModel.ZipSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{x:Bind ViewModel.ZipFilterOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedZipFilter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.FilteredZipEntries, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedZipEntry, Mode=TwoWay}"
                          SelectionMode="Single"
                          MaxHeight="140"
                          HorizontalAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ZipEntryViewModel">
                            <Grid ColumnSpacing="10" Padding="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8D5;" FontSize="13"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind FullName}"
                                               Style="{StaticResource SmallMetaTextStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PaneBorderStyle}"
                Padding="10"
                Visibility="{x:Bind ViewModel.IsObjectModelMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE82D;" FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.LoadedZipName, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Style="{StaticResource PillBorderStyle}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{x:Bind ViewModel.HasUnsavedObjectModelChanges, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Unsaved changes" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ObjectModelSummaryText, Mode=OneWay}"
                                   Style="{StaticResource SmallMetaTextStyle}"/>
                    </StackPanel>

                    <TextBox Grid.Column="2"
                             PlaceholderText="Search object models and groups"
                             Text="{x:Bind ViewModel.ObjectModelSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                </Grid>

                <TreeView x:Name="ObjectModelTree"
                          Grid.Row="1"
                          SelectionMode="Single"
                          CanDragItems="False"
                          CanReorderItems="False"
                          MaxHeight="240"
                          ItemInvoked="ObjectModelTree_ItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Content.Badge}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Content.DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Content.Subtitle}"
                                               Style="{StaticResource SmallMetaTextStyle}"/>
                                </StackPanel>

                                <FontIcon Grid.Column="2" Glyph="&#xE7C3;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Content.IsDirty, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Border Grid.Row="2"
                        Margin="0,4,0,0"
                        Style="{StaticResource PaneBorderStyle}"
                        Padding="10">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="Patch Scribbledata"
                                       Style="{StaticResource PaneTitleStyle}"/>
                            <TextBlock Text="Patch every source/scribbledata object model that matches one object type and one property id."
                                       Style="{StaticResource SmallMetaTextStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.ObjectModelPatchStatusText, Mode=OneWay}"
                                       Style="{StaticResource SmallMetaTextStyle}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Object type"
                                       Style="{StaticResource ColumnHeaderTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="Property"
                                       Style="{StaticResource ColumnHeaderTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="Value"
                                       Style="{StaticResource ColumnHeaderTextStyle}"/>

                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.ObjectModelPatchObjectTypes}"
                                      SelectedItem="{x:Bind ViewModel.SelectedObjectModelPatchType, Mode=TwoWay}"
                                      PlaceholderText="Select object type"
                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                      HorizontalAlignment="Stretch"/>

                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.ObjectModelPatchProperties}"
                                      SelectedItem="{x:Bind ViewModel.SelectedObjectModelPatchProperty, Mode=TwoWay}"
                                      PlaceholderText="Select property id"
                                      IsEnabled="{x:Bind ViewModel.IsObjectModelPatchTypeSelected, Mode=OneWay}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBox Grid.Row="1" Grid.Column="2"
                                     PlaceholderText="Value to write into every matching property"
                                     Text="{x:Bind ViewModel.ObjectModelPatchValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>

                            <Button Grid.Row="1" Grid.Column="3"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ApplyObjectModelPatchCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsObjectModelPatchReady, Mode=OneWay}"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE968;" FontSize="14"/>
                                    <TextBlock Text="Patch"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              Background="Transparent"
              AllowDrop="True"
              DragOver="Page_DragOver"
              Drop="Page_Drop"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8D5;" FontSize="52"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Drop a .bxml, .xml, or .zip file"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              ColumnSpacing="10"
              Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="320"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Entry Tree" Style="{StaticResource PaneTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DocumentSummaryText, Mode=OneWay}"
                                       Style="{StaticResource SmallMetaTextStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.BrowserResultCountText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBox Grid.Row="1"
                             PlaceholderText="Search entries and fields"
                             Text="{x:Bind ViewModel.NodeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.NodeFilterOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedNodeFilter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <TreeView x:Name="EntryTree"
                              Grid.Row="3"
                              SelectionMode="Single"
                              CanDragItems="False"
                              CanReorderItems="False"
                              ItemInvoked="EntryTree_ItemInvoked"
                              Padding="0,2,0,8">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Content.LevelText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Content.DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Content.Subtitle}"
                                                   Style="{StaticResource SmallMetaTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Content.FieldCountText}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Content.ChildCountText}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PaneBorderStyle}">
                <Pivot Padding="0">
                    <PivotItem Header="Entry">
                        <Grid RowSpacing="10" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsNodeNotSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="&#xE8A4;" FontSize="38"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="No entry selected"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.RowSpan="5"
                                  RowSpacing="10"
                                  Visibility="{x:Bind ViewModel.IsNodeSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedEntryTitle, Mode=OneWay}"
                                                   Style="{StaticResource PaneTitleStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedEntrySubtitle, Mode=OneWay}"
                                                   Style="{StaticResource SmallMetaTextStyle}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedEntryFieldCountText, Mode=OneWay}" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PillBorderStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedEntryChildCountText, Mode=OneWay}" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Command="{x:Bind ViewModel.AddChildElementCommand}"
                                                Style="{StaticResource GhostAccentButtonStyle}"
                                                Padding="8,5"
                                                ToolTipService.ToolTip="Add a child element">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Add Child" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.AddPropertyFieldCommand}"
                                                Style="{StaticResource GhostAccentButtonStyle}"
                                                Padding="8,5"
                                                ToolTipService.ToolTip="Add a &lt;property&gt; field">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Add Property" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.DuplicateSelectedElementCommand}"
                                                Style="{StaticResource GhostAccentButtonStyle}"
                                                Padding="8,5"
                                                ToolTipService.ToolTip="Duplicate this element">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                <TextBlock Text="Duplicate" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.DeleteSelectedElementCommand}"
                                                Style="{StaticResource GhostAccentButtonStyle}"
                                                Padding="8,5"
                                                ToolTipService.ToolTip="Delete this element">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"
                                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                <TextBlock Text="Delete" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Header="Element Name"
                                             Text="{x:Bind ViewModel.SelectedNode.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Element name"/>

                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.AddAttributeCommand}"
                                            Style="{StaticResource GhostAccentButtonStyle}"
                                            Padding="8,5"
                                            VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="Add direct attribute">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            <TextBlock Text="Add Attribute" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Bundled Fields" Style="{StaticResource PaneTitleStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedNodePath, Mode=OneWay}"
                                                   Style="{StaticResource SmallMetaTextStyle}"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="1"
                                             PlaceholderText="Search fields"
                                             Text="{x:Bind ViewModel.AttributeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Border Grid.Row="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6,6,0,0">
                                    <Grid ColumnSpacing="8" Padding="10,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Element" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="Field" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                        <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="5"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,6,6">
                                    <Grid>
                                        <TextBlock Text="No matching fields"
                                                   Style="{StaticResource SmallMetaTextStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind ViewModel.IsSelectedEntryFieldListEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                                        <ListView ItemsSource="{x:Bind ViewModel.SelectedEntryFields, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:BXMLFieldViewModel">
                                                    <Grid ColumnSpacing="8" Padding="2,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{x:Bind SourceName}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsReadOnly="{x:Bind IsNameReadOnly, Mode=OneWay}"
                                                                 FontSize="13"/>
                                                        <TextBox Grid.Column="2"
                                                                 Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="13"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </PivotItem>

                    <PivotItem Header="XML Source">
                        <Grid RowSpacing="8" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="XML Source" Style="{StaticResource PaneTitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.XmlSummaryText, Mode=OneWay}"
                                               Style="{StaticResource SmallMetaTextStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                                            Command="{x:Bind ViewModel.SyncTreeToXmlCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                            Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="12"/>
                                            <TextBlock Text="Refresh" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource GhostAccentButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyXmlChangesCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                            Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                                            <TextBlock Text="Apply" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <TextBox Grid.Row="2"
                                     Text="{x:Bind ViewModel.XmlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="13"
                                     IsSpellCheckEnabled="False"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>
        </Grid>
    </Grid>
</Page>